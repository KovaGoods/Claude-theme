<div class="shop-page">

  <!-- Shop Hero — Product Centered -->
  <div class="shop-hero">
    <div class="shop-hero-bg">
      <div class="sh-glow sh-glow-1"></div>
      <div class="sh-glow sh-glow-2"></div>
    </div>
    <div class="container">
      <div class="shop-hero-layout">

        <!-- Product Image — CENTER -->
        <div class="shop-product-visual">
          <div class="shop-product-glow"></div>
          {% assign main_product = all_products['sensory-bubble-tube-lamp'] %}
          {% if main_product and main_product.featured_image %}
            <img
              src="{{ main_product.featured_image | img_url: '700x700' }}"
              alt="{{ main_product.title }}"
              class="shop-product-img"
            >
          {% else %}
            <div class="shop-product-placeholder">
              <div class="spp-tube">
                <div class="spp-fish">🐠</div>
                <div class="spp-fish spp-fish-2">🐡</div>
              </div>
            </div>
          {% endif %}
        </div>

        <!-- Product Info -->
        <div class="shop-product-info">
          <div class="shop-product-badge">
            <i class="fas fa-fire"></i> Best Seller
          </div>
          <h1 class="shop-product-title">
            Sensory Bubble<br>
            <span class="shop-title-accent">Fish Lamp</span>
          </h1>
          <p class="shop-product-desc">
            A mesmerizing floor lamp featuring real fish and rising bubbles.
            Choose your perfect size below.
          </p>

          <!-- Ratings -->
          <div class="shop-ratings">
            <span class="shop-stars">★★★★★</span>
            <span class="shop-rating-count">4.9 (2,400+ reviews)</span>
          </div>

          <!-- Size Cards -->
          <div class="shop-size-grid">

            <a href="/products/sensory-bubble-tube-lamp?variant=267ft"
               class="shop-size-card">
              <div class="ssc-size">2.67 ft</div>
              <div class="ssc-height">~80cm</div>
              <div class="ssc-price">$89.99</div>
              <div class="ssc-tag">Compact</div>
            </a>

            <a href="/products/sensory-bubble-tube-lamp?variant=33ft"
               class="shop-size-card">
              <div class="ssc-size">3.3 ft</div>
              <div class="ssc-height">~100cm</div>
              <div class="ssc-price">$109.99</div>
              <div class="ssc-tag">Popular</div>
            </a>

            <a href="/products/sensory-bubble-tube-lamp?variant=4ft"
               class="shop-size-card ssc-featured">
              <div class="ssc-best">⭐ Best</div>
              <div class="ssc-size">4 ft</div>
              <div class="ssc-height">~120cm</div>
              <div class="ssc-price">$149.99</div>
              <div class="ssc-tag gift-tag">🎁 Free Gift</div>
            </a>

            <a href="/products/sensory-bubble-tube-lamp?variant=5ft"
               class="shop-size-card ssc-featured">
              <div class="ssc-best">⭐ Best</div>
              <div class="ssc-size">5 ft</div>
              <div class="ssc-height">~150cm</div>
              <div class="ssc-price">$159.99</div>
              <div class="ssc-tag gift-tag">🎁 Free Gift</div>
            </a>

          </div>

          <!-- Promo -->
          <div class="shop-promo-strip">
            🎁 Order 4ft or 5ft and get a <strong>FREE Bluetooth Lamp</strong> — Limited offer!
          </div>

          <!-- Trust -->
          <div class="shop-trust-row">
            <div class="str-item">
              <i class="fas fa-shipping-fast"></i>
              <span>Free USA Shipping</span>
            </div>
            <div class="str-item">
              <i class="fas fa-undo"></i>
              <span>30-Day Returns</span>
            </div>
            <div class="str-item">
              <i class="fas fa-shield-alt"></i>
              <span>Secure Checkout</span>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

</div>


<style>
/* =====================
   SHOP PAGE
   ===================== */
.shop-page { padding-bottom: 80px; }

/* Shop Hero */
.shop-hero {
  position: relative;
  background: linear-gradient(135deg, #0D1B2A 0%, #1A2B4A 55%, #0D3B4A 100%);
  padding: 100px 0 80px;
  overflow: hidden;
}
.shop-hero-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.sh-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(120px);
  opacity: 0.2;
}
.sh-glow-1 {
  width: 500px; height: 500px;
  background: var(--color-aqua);
  top: -100px; left: 30%;
}
.sh-glow-2 {
  width: 350px; height: 350px;
  background: #7B2FBE;
  bottom: -80px; right: 10%;
}

/* Layout */
.shop-hero-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}

/* Product Visual */
.shop-product-visual {
  position: relative;
  display: flex;
  justify-content: center;
}
.shop-product-glow {
  position: absolute;
  width: 80%;
  height: 80%;
  background: radial-gradient(circle, rgba(0,201,200,0.3), transparent 70%);
  top: 50%;
  left: 50%;
  transform: translate(-50%,-50%);
  border-radius: 50%;
  filter: blur(50px);
  animation: shopGlowPulse 4s ease-in-out infinite;
}
@keyframes shopGlowPulse {
  0%,100% { opacity:0.6; transform:translate(-50%,-50%) scale(1);   }
  50%      { opacity:1;   transform:translate(-50%,-50%) scale(1.2); }
}
.shop-product-img {
  width: 100%;
  max-width: 460px;
  border-radius: 24px;
  box-shadow: 0 40px 80px rgba(0,0,0,0.5), 0 0 60px rgba(0,201,200,0.2);
  animation: shopFloat 6s ease-in-out infinite;
  position: relative;
  z-index: 1;
}
@keyframes shopFloat {
  0%,100% { transform: translateY(0);    }
  50%      { transform: translateY(-14px); }
}
.shop-product-placeholder {
  width: 300px;
  height: 400px;
  background: rgba(0,201,200,0.05);
  border-radius: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
  border: 1px solid rgba(0,201,200,0.1);
}
.spp-tube {
  width: 70px;
  height: 280px;
  background: linear-gradient(180deg, rgba(0,201,200,0.6), rgba(123,47,190,0.4));
  border-radius: 35px 35px 0 0;
  position: relative;
  box-shadow: 0 0 40px rgba(0,201,200,0.4);
  animation: lampGlow 3s ease-in-out infinite;
}
.spp-fish {
  position: absolute;
  font-size: 24px;
  left: 50%;
  top: 35%;
  transform: translateX(-50%);
  animation: fishSwimTube 4s ease-in-out infinite;
}
.spp-fish-2 {
  font-size: 18px;
  top: 60%;
  animation-delay: 2s;
}

/* Product Info */
.shop-product-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(231,76,60,0.15);
  border: 1px solid rgba(231,76,60,0.3);
  color: #E74C3C;
  padding: 6px 16px;
  border-radius: 50px;
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 16px;
  letter-spacing: 0.5px;
}
.shop-product-title {
  font-size: clamp(30px, 3.5vw, 48px);
  font-weight: 800;
  color: var(--color-white);
  line-height: 1.15;
  margin-bottom: 16px;
}
.shop-title-accent {
  background: linear-gradient(135deg, var(--color-aqua), #7B2FBE);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.shop-product-desc {
  font-size: 16px;
  color: rgba(255,255,255,0.6);
  line-height: 1.7;
  margin-bottom: 16px;
}
.shop-ratings {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 28px;
}
.shop-stars {
  color: #F0C040;
  font-size: 16px;
  letter-spacing: 2px;
}
.shop-rating-count {
  font-size: 13px;
  color: rgba(255,255,255,0.5);
  font-weight: 500;
}

/* Size Cards Grid */
.shop-size-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 20px;
}
.shop-size-card {
  position: relative;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 16px;
  padding: 20px 16px;
  text-align: center;
  transition: var(--transition);
  display: block;
  overflow: hidden;
}
.shop-size-card:hover {
  border-color: var(--color-aqua);
  background: rgba(0,201,200,0.08);
  transform: translateY(-4px);
  box-shadow: 0 12px 40px rgba(0,201,200,0.15);
}
.ssc-featured {
  border-color: rgba(0,201,200,0.3) !important;
  background: rgba(0,201,200,0.06) !important;
}
.ssc-best {
  position: absolute;
  top: 8px;
  right: 8px;
  background: var(--color-aqua);
  color: var(--color-primary);
  font-size: 10px;
  font-weight: 800;
  padding: 3px 8px;
  border-radius: 6px;
}
.ssc-size {
  font-size: 22px;
  font-weight: 800;
  color: var(--color-white);
  margin-bottom: 4px;
}
.ssc-height {
  font-size: 12px;
  color: rgba(255,255,255,0.4);
  margin-bottom: 8px;
}
.ssc-price {
  font-size: 18px;
  font-weight: 700;
  color: var(--color-aqua);
  margin-bottom: 6px;
}
.ssc-tag {
  font-size: 11px;
  color: rgba(255,255,255,0.4);
  font-weight: 600;
}
.gift-tag {
  color: #F0C040 !important;
}

/* Promo Strip */
.shop-promo-strip {
  background: rgba(240,192,64,0.08);
  border: 1px solid rgba(240,192,64,0.2);
  border-radius: 12px;
  padding: 12px 16px;
  font-size: 13px;
  color: #F0C040;
  margin-bottom: 20px;
  line-height: 1.5;
}

/* Trust Row */
.shop-trust-row {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}
.str-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: rgba(255,255,255,0.55);
  font-weight: 500;
}
.str-item i {
  color: var(--color-aqua);
  font-size: 16px;
}

/* =====================
   RESPONSIVE
   ===================== */
@media (max-width: 1024px) {
  .shop-hero-layout {
    grid-template-columns: 1fr;
    text-align: center;
  }
  .shop-product-visual { order: -1; }
  .shop-trust-row      { justify-content: center; }
  .shop-ratings        { justify-content: center; }
  .shop-size-grid      { max-width: 400px; margin-left: auto; margin-right: auto; }
}
@media (max-width: 600px) {
  .shop-size-grid { grid-template-columns: 1fr 1fr; gap: 8px; }
  .shop-hero      { padding: 80px 0 60px; }
}
</style>
