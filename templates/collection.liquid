<div class="collection-page">

  <!-- Hero -->
  <div class="page-hero">
    <div class="container">
      <h1>{{ collection.title | default: 'All Products' }}</h1>
      <p>{{ collection.description | default: 'Premium Sensory Bubble Fish Lamps — Free USA Shipping' }}</p>
    </div>
  </div>

  <div class="container">
    <div class="collection-layout">

      <!-- Filters Bar -->
      <div class="collection-toolbar">
        <p class="collection-count">
          {{ collection.products_count }} product{{ collection.products_count | plural: '', 's' }}
        </p>
        <div class="collection-sort">
          <label for="sort-select">Sort by:</label>
          <select id="sort-select" onchange="sortCollection(this.value)">
            <option value="manual">Featured</option>
            <option value="price-ascending">Price: Low to High</option>
            <option value="price-descending">Price: High to Low</option>
            <option value="title-ascending">Name: A–Z</option>
            <option value="best-selling">Best Selling</option>
          </select>
        </div>
      </div>

      <!-- Products Grid -->
      {% if collection.products.size > 0 %}
        <div class="products-grid collection-grid">
          {% for product in collection.products %}
            <div class="product-card">

              {% if product.tags contains 'bestseller' %}
                <div class="product-badge bestseller">Best Seller</div>
              {% elsif product.tags contains 'popular' %}
                <div class="product-badge popular">Most Popular</div>
              {% endif %}

              <div class="product-image-wrap">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | img_url: '600x600' }}"
                    alt="{{ product.title }}"
                    class="product-img"
                    loading="lazy"
                  >
                {% else %}
                  <div class="product-img-placeholder">
                    <i class="fas fa-lightbulb"></i>
                  </div>
                {% endif %}
                <div class="product-overlay">
                  <a href="{{ product.url }}"
                     class="btn-primary"
                     style="padding:12px 28px; font-size:14px;">
                    View Details
                  </a>
                </div>
              </div>

              <div class="product-info">
                <h3 class="product-title">{{ product.title }}</h3>
                <p class="product-desc">
                  {{ product.description | strip_html | truncate: 80 }}
                </p>
                <div class="product-footer">
                  <div class="product-price">
                    {% if product.compare_at_price > product.price %}
                      <span class="price-compare">
                        {{ product.compare_at_price | money }}
                      </span>
                    {% endif %}
                    <span class="price-current">{{ product.price | money }}</span>
                  </div>
                  <a href="{{ product.url }}" class="add-to-cart-btn">
                    <i class="fas fa-cart-plus"></i> Add to Cart
                  </a>
                </div>
              </div>

            </div>
          {% endfor %}
        </div>

      {% else %}
        <div class="collection-empty">
          <div style="font-size:60px; margin-bottom:16px;">🔍</div>
          <h2>No products found</h2>
          <p>Check back soon — new items coming!</p>
          <a href="/" class="btn-primary" style="margin-top:24px;">Go Home</a>
        </div>
      {% endif %}

    </div>
  </div>
</div>

<script>
function sortCollection(val) {
  const url = new URL(window.location.href);
  url.searchParams.set('sort_by', val);
  window.location.href = url.toString();
}
</script>

<style>
.collection-page { padding-bottom: 100px; }

.collection-layout { padding: 40px 0; }

.collection-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32px;
  padding-bottom: 20px;
  border-bottom: 1px solid rgba(0,0,0,0.06);
}
.collection-count {
  font-size: 14px;
  color: var(--color-gray);
  font-weight: 600;
}
.collection-sort {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  color: var(--color-gray);
}
.collection-sort select {
  padding: 8px 16px;
  border: 2px solid rgba(0,0,0,0.08);
  border-radius: 8px;
  font-size: 14px;
  font-family: var(--font-main);
  color: var(--color-primary);
  outline: none;
  cursor: pointer;
  background: var(--color-light);
  transition: var(--transition);
}
.collection-sort select:focus {
  border-color: var(--color-aqua);
}

.collection-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}

.collection-empty {
  text-align: center;
  padding: 80px 20px;
  color: var(--color-gray);
}
.collection-empty h2 {
  font-size: 24px;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 8px;
}

@media (max-width: 1024px) {
  .collection-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 480px) {
  .collection-grid { grid-template-columns: 1fr; }
  .collection-toolbar { flex-direction: column; gap: 12px; align-items: flex-start; }
}
</style>
