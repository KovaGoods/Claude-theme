<div class="page-hero">
  <div class="container">
    <h1>Contact <span style="color: #00C9C8">Us</span></h1>
    <p>We're here to help — reach out anytime!</p>
  </div>
</div>

<div class="page-content">
  <div class="container">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: start">

      <div>
        <h2 style="margin-top: 0">Send Us a Message</h2>
        {% form 'contact' %}
          {% if form.posted_successfully? %}
            <div style="background: #E8F8F0; border: 1px solid #27AE60; border-radius: 12px; padding: 16px; color: #27AE60; font-weight: 600; margin-bottom: 20px">
              ✅ Thank you! Your message has been sent. We'll respond within 24 hours.
            </div>
          {% endif %}

          <div class="form-group">
            <label for="contact-name">Your Name</label>
            <input type="text" id="contact-name" name="contact[name]" placeholder="John Smith" required>
          </div>

          <div class="form-group">
            <label for="contact-email">Email Address</label>
            <input type="email" id="contact-email" name="contact[email]" placeholder="john@example.com" required>
          </div>

          <div class="form-group">
            <label for="contact-subject">Subject</label>
            <input type="text" id="contact-subject" name="contact[subject]" placeholder="Order inquiry, return request...">
          </div>

          <div class="form-group">
            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="contact[body]" placeholder="Tell us how we can help..." required></textarea>
          </div>

          <button type="submit" class="btn-primary" style="width: 100%; padding: 16px">
            <i class="fas fa-paper-plane"></i> &nbsp; Send Message
          </button>
        {% endform %}
      </div>

      <div>
        <h2 style="margin-top: 0">Contact Information</h2>

        <div style="display: flex; flex-direction: column; gap: 20px">
          <div style="background: #F4F8FB; border-radius: 16px; padding: 24px; display: flex; gap: 16px; align-items: flex-start">
            <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #00C9C8, #0099CC); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: white; font-size: 18px; flex-shrink: 0">
              <i class="fas fa-headset"></i>
            </div>
            <div>
              <h4 style="color: #1A2B4A; margin-bottom: 8px">Customer Support</h4>
              <a href="mailto:support@kovagoods.store" style="color: #00C9C8; font-size: 14px">support@kovagoods.store</a>
              <p style="color: #7F8C8D; font-size: 13px; margin-top: 4px">For orders, returns & support</p>
            </div>
          </div>

          <div style="background: #F4F8FB; border-radius: 16px; padding: 24px; display: flex; gap: 16px; align-items: flex-start">
            <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #00C9C8, #0099CC); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: white; font-size: 18px; flex-shrink: 0">
              <i class="fas fa-envelope"></i>
            </div>
            <div>
              <h4 style="color: #1A2B4A; margin-bottom: 8px">General Inquiries</h4>
              <a href="mailto:info@kovagoods.store" style="color: #00C9C8; font-size: 14px">info@kovagoods.store</a>
              <p style="color: #7F8C8D; font-size: 13px; margin-top: 4px">For general questions</p>
            </div>
          </div>

          <div style="background: #F4F8FB; border-radius: 16px; padding: 24px; display: flex; gap: 16px; align-items: flex-start">
            <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #00C9C8, #0099CC); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: white; font-size: 18px; flex-shrink: 0">
              <i class="fas fa-clock"></i>
            </div>
            <div>
              <h4 style="color: #1A2B4A; margin-bottom: 8px">Response Time</h4>
              <p style="color: #7F8C8D; font-size: 14px">We respond within 24 hours<br>7 days a week</p>
            </div
