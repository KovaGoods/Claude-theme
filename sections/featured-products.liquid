<!-- ═══════════════════════════════════════════════
     SCRIPTS — Real Add to Cart
═══════════════════════════════════════════════ -->
<script>
function fpAddToCart(variantId, btn) {
  if (!variantId) return;

  var label   = btn.querySelector('.fp-btn-label');
  var spinner = btn.querySelector('.fp-btn-loading');
  var icon    = btn.querySelector('.fa-cart-plus');

  // Loading state
  btn.disabled = true;
  if (icon)    icon.style.display    = 'none';
  if (label)   label.textContent     = 'Adding…';
  if (spinner) spinner.style.display = 'inline-block';

  fetch('/cart/add.js', {
    method:  'POST',
    headers: { 'Content-Type': 'application/json' },
    body:    JSON.stringify({ id: parseInt(variantId), quantity: 1 })
  })
  .then(function(r) { return r.json(); })
  .then(function() {
    // Success state
    if (spinner) spinner.style.display = 'none';
    if (icon) {
      icon.className = 'fas fa-check';
      icon.style.display = 'inline-block';
    }
    if (label) label.textContent = 'Added!';
    btn.classList.add('fp-added');

    // Update cart count in header if exists
    fetch('/cart.js')
      .then(function(r) { return r.json(); })
      .then(function(cart) {
        var counters = document.querySelectorAll('.cart-count, .cart-item-count, [data-cart-count]');
        counters.forEach(function(el) {
          el.textContent = cart.item_count;
        });
      });

    // Reset after 2 seconds
    setTimeout(function() {
      btn.disabled = false;
      btn.classList.remove('fp-added');
      if (icon) {
        icon.className = 'fas fa-cart-plus';
        icon.style.display = 'inline-block';
      }
      if (label) label.textContent = 'Add to Cart';
    }, 2000);
  })
  .catch(function(err) {
    console.error('Cart error:', err);
    if (spinner) spinner.style.display = 'none';
    if (icon) {
      icon.className = 'fas fa-exclamation-circle';
      icon.style.display = 'inline-block';
    }
    if (label) label.textContent = 'Try Again';
    btn.disabled = false;

    setTimeout(function() {
      if (icon) icon.className = 'fas fa-cart-plus';
      if (label) label.textContent = 'Add to Cart';
    }, 2000);
  });
}
</script>


