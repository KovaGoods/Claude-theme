{% assign main_product = all_products['sensory-bubble-tube-lamp-5-ft-bubble-fish-tube-sensory-aquarium-lamp-with-10-floating-fish-16-color-effects-remote-control-stress-relief-calming-light-for-bedroom-living-room-home-decor'] %}

<!-- ═══════════════════════════════════════════════
     FEATURED PRODUCTS — CREATIVE REDESIGN
═══════════════════════════════════════════════ -->
<section class="fp-section" id="size-grid">
  <div class="fp-container">

    <!-- ── Section Header ── -->
    <div class="fp-header">
      <div class="fp-header-badge">
        <span class="fp-badge-dot"></span>
        <i class="fas fa-layer-group"></i>
        Choose Your Size
      </div>
      <h2 class="fp-title">
        Find Your <span class="fp-title-gradient">Perfect Match</span>
      </h2>
      <p class="fp-subtitle">
        Every size delivers the same mesmerizing experience — bubbles, floating fish,
        and 16 color modes. Pick the one that fits your space perfectly.
      </p>

      <!-- Feature Pills -->
      <div class="fp-pills">
        <div class="fp-pill">
          <i class="fas fa-fish"></i> 10 Floating Fish
        </div>
        <div class="fp-pill">
          <i class="fas fa-palette"></i> 16 Color Modes
        </div>
        <div class="fp-pill">
          <i class="fas fa-remote"></i> Remote Control
        </div>
        <div class="fp-pill">
          <i class="fas fa-truck"></i> Free Shipping
        </div>
      </div>
    </div>

    <!-- ── Cards Grid ── -->
    <div class="fp-grid">

      {% for variant in main_product.variants %}
        {% unless variant.title contains '15' or variant.title contains 'Bluetooth' %}

          {% assign is_popular = false %}
          {% assign has_gift   = false %}

          {% if variant.title contains '48' or variant.title contains '4 ft' or variant.title contains '4ft' %}
            {% assign is_popular = true %}
            {% assign has_gift   = true %}
          {% endif %}
          {% if variant.title contains '60' or variant.title contains '5 ft' or variant.title contains '5ft' %}
            {% assign has_gift = true %}
          {% endif %}

          <!-- ── Single Card ── -->
          <div class="fp-card {% if is_popular %}fp-card--popular{% endif %}"
               data-variant-id="{{ variant.id }}"
               data-has-gift="{{ has_gift }}">

            {% if is_popular %}
              <div class="fp-ribbon">
                <i class="fas fa-crown"></i> Most Popular
              </div>
            {% endif %}

            <!-- ── Image Block ── -->
            <div class="fp-img-block">

              <!-- Ambient Glow -->
              <div class="fp-img-glow"></div>

              {% if main_product.featured_image %}
                <img
                  src="{{ main_product.featured_image | img_url: '600x600' }}"
                  alt="Sensory Bubble Fish Lamp — {{ variant.title }}"
                  class="fp-img"
                  loading="lazy"
                >
              {% else %}
                <div class="fp-img-fallback">
                  <div class="fp-tube-anim">
                    <span>🐠</span><span>🐡</span>
                  </div>
                </div>
              {% endif %}

              <!-- Size Badge on Image -->
              <div class="fp-img-size-badge">
                <i class="fas fa-ruler-vertical"></i>
                {{ variant.title }}
              </div>

              <!-- Gift Overlay — only for big sizes -->
              {% if has_gift %}
                <div class="fp-gift-overlay">
                  <img
                    src="https://cdn.shopify.com/s/files/1/1026/4831/6287/files/free.png?v=1788269990"
                    alt="Free Bonus Lamp"
                    class="fp-gift-overlay-img"
                  >
                  <span>+ Free Bonus Lamp!</span>
                </div>
              {% endif %}

              <!-- Hover Overlay -->
              <div class="fp-hover-overlay">
                <a href="/pages/shop#size-selector" class="fp-hover-btn">
                  <i class="fas fa-eye"></i> View Full Details
                </a>
              </div>

            </div><!-- /fp-img-block -->

            <!-- ── Info Block ── -->
            <div class="fp-info">

              <!-- Title + Size -->
              <div class="fp-info-top">
                <h3 class="fp-card-title">Sensory Bubble Fish Lamp</h3>
                <div class="fp-size-chip">
                  <i class="fas fa-ruler"></i> {{ variant.title }}
                </div>
              </div>

              <!-- Description (unique per size range) -->
              <p class="fp-card-desc">
                {% if variant.title contains '32' or variant.title contains '2.67' %}
                  Perfect for desks, shelves &amp; small corners. Compact glow that transforms any nook into a calming sanctuary.
                {% elsif variant.title contains '39' or variant.title contains '3.3' %}
                  Ideal for bedrooms &amp; reading nooks. Mid-size presence with full color impact and floating fish effect.
                {% elsif variant.title contains '48' or variant.title contains '4 ft' or variant.title contains '4ft' %}
                  The crowd favorite. Floor-standing statement piece that fills the room with mesmerizing aquatic light.
                {% elsif variant.title contains '60' or variant.title contains '5 ft' or variant.title contains '5ft' %}
                  Maximum impact. Our tallest lamp dominates any space — living rooms, therapy offices &amp; studios.
                {% else %}
                  A stunning sensory lamp with floating fish, rising bubbles and 16 color effects.
                {% endif %}
              </p>

              <!-- Gift Badge -->
              {% if has_gift %}
                <div class="fp-gift-badge">
                  <img
                    src="https://cdn.shopify.com/s/files/1/1026/4831/6287/files/free.png?v=1788269990"
                    alt="Free Lamp"
                    class="fp-gift-badge-img"
                  >
                  <div class="fp-gift-badge-text">
                    <span class="fp-gift-badge-title">🎁 Free Sensory Lamp Included</span>
                    <span class="fp-gift-badge-sub">A $60+ bonus — yours free!</span>
                  </div>
                </div>
              {% endif %}

              <!-- Stars -->
              <div class="fp-stars">
                <span class="fp-stars-icons">★★★★</span><span class="fp-stars-half">★</span>
                <span class="fp-stars-num">4.8</span>
                <span class="fp-stars-count">(247)</span>
              </div>

              <!-- Price + CTA -->
              <div class="fp-footer">
                <div class="fp-price-block">
                  {% assign compare_price = variant.price | plus: 2000 %}
                  <span class="fp-price-compare">{{ compare_price | money }}</span>
                  <span class="fp-price-current">{{ variant.price | money }}</span>
                  <span class="fp-price-save">Save $20</span>
                </div>

                <button
                  class="fp-add-btn"
                  onclick="fpAddToCart('{{ variant.id }}', this)"
                  aria-label="Add {{ variant.title }} to cart"
                >
                  <i class="fas fa-cart-plus"></i>
                  <span class="fp-btn-label">Add to Cart</span>
                  <span class="fp-btn-loading" style="display:none">
                    <i class="fas fa-spinner fa-spin"></i>
                  </span>
                </button>
              </div>

            </div><!-- /fp-info -->
          </div><!-- /fp-card -->

        {% endunless %}
      {% endfor %}

    </div><!-- /fp-grid -->

    <!-- ── Bottom CTA ── -->
    <div class="fp-bottom-cta">
      <div class="fp-bottom-text">
        <i class="fas fa-shield-alt"></i> 30-Day Returns &nbsp;·&nbsp;
        <i class="fas fa-truck"></i> Free Shipping &nbsp;·&nbsp;
        <i class="fas fa-lock"></i> Secure Checkout
      </div>
      <a href="/pages/shop" class="fp-explore-btn">
        <i class="fas fa-th-large"></i>
        Explore Full Shop
        <i class="fas fa-arrow-right"></i>
      </a>
    </div>

  </div><!-- /fp-container -->
</section>


