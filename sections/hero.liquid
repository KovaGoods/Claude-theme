{% assign p = all_products['sensory-bubble-tube-lamp-5-ft-bubble-fish-tube-sensory-aquarium-lamp-with-10-floating-fish-16-color-effects-remote-control-stress-relief-calming-light-for-bedroom-living-room-home-decor'] %}
<section class="ph-section">
<!-- Ambient Background Particles -->
<div class="ph-bg">
  <div class="ph-bubble ph-bubble--1"></div>
  <div class="ph-bubble ph-bubble--2"></div>
  <div class="ph-bubble ph-bubble--3"></div>
  <div class="ph-bubble ph-bubble--4"></div>
  <div class="ph-bubble ph-bubble--5"></div>
  <div class="ph-glow ph-glow--left"></div>
  <div class="ph-glow ph-glow--right"></div>
</div>
<div class="ph-container">

  <!-- LEFT: IMAGE SIDE -->
  <div class="ph-visual">
    <div class="ph-frame">
      <div class="ph-frame-glow"></div>
      <div class="ph-img-wrap" id="ph-main-img-wrap">
        {% if p.featured_image %}
        <img
          src="{{ p.featured_image | img_url: '800x800' }}"
          alt="{{ p.title }}"
          class="ph-main-img"
          id="ph-main-img"
        >
        {% endif %}
        <div class="ph-orb ph-orb--1"></div>
        <div class="ph-orb ph-orb--2"></div>
      </div>
      <div class="ph-live-badge">
        <span class="ph-live-dot"></span>
        Live Preview
      </div>
      <div class="ph-discount-tag">
        <span class="ph-discount-num">20%</span>
        <span class="ph-discount-txt">OFF</span>
      </div>
    </div>
    <div class="ph-thumbs">
      {% for image in p.images limit: 5 %}
      <button
        class="ph-thumb {% if forloop.first %}ph-thumb--active{% endif %}"
        onclick="phSwitchImg('{{ image | img_url: '800x800' }}', this)"
        aria-label="View image {{ forloop.index }}"
      >
        <img src="{{ image | img_url: '120x120' }}" alt="View {{ forloop.index }}" loading="lazy">
      </button>
      {% endfor %}
    </div>
  </div>

  <!-- RIGHT: INFO SIDE -->
  <div class="ph-info">
    <div class="ph-labels">
      <span class="ph-label ph-label--new"><i class="fas fa-star"></i> New Arrival</span>
      <span class="ph-label ph-label--stock"><i class="fas fa-check-circle"></i> In Stock</span>
    </div>
    <h1 class="ph-title">
      Sensory Bubble
      <span class="ph-title-highlight">Fish Lamp</span>
    </h1>
    <div class="ph-stars">
      <div class="ph-stars-icons">
        <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
        <i class="fas fa-star"></i><i class="fas fa-star-half-alt"></i>
      </div>
      <span class="ph-stars-count">4.8</span>
      <span class="ph-stars-reviews">(247 reviews)</span>
    </div>
    <div class="ph-price-block">
      <div class="ph-price-wrap" id="ph-price-display">
        <span class="ph-price-old" id="ph-price-old">$179.99</span>
        <span class="ph-price-current" id="ph-price-current">$149.99</span>
      </div>
      <div class="ph-price-save">You save <strong>$30.00</strong> today!</div>
    </div>
    <div class="ph-divider"></div>

    <!-- Size Selector -->
    <div class="ph-sizes">
      <div class="ph-sizes-label">
        <i class="fas fa-ruler-vertical"></i>
        Select Your Size
        <span class="ph-sizes-hint">— hover to preview</span>
      </div>
      <div class="ph-sizes-grid">
        {% for variant in p.variants %}
        {% unless variant.title contains '15' or variant.title contains 'Bluetooth' %}
        {% assign has_gift = false %}
        {% if variant.title contains '48' or variant.title contains '4 ft' or variant.title contains '4ft'
           or variant.title contains '60' or variant.title contains '5 ft' or variant.title contains '5ft' %}
          {% assign has_gift = true %}
        {% endif %}
        {% assign is_popular = false %}
        {% if variant.title contains '48' or variant.title contains '4 ft' or variant.title contains '4ft' %}
          {% assign is_popular = true %}
        {% endif %}
        <div
          class="ph-size-card {% if is_popular %}ph-size-card--popular{% endif %}"
          data-variant-id="{{ variant.id }}"
          data-price="{{ variant.price | money }}"
          data-compare="{{ variant.price | plus: 2000 | money }}"
          data-has-gift="{{ has_gift }}"
          onclick="phSelectSize(this)"
        >
          {% if is_popular %}<div class="ph-size-ribbon">⭐ Best</div>{% endif %}
          <div class="ph-size-icon"><i class="fas fa-ruler"></i></div>
          <div class="ph-size-name">{{ variant.title }}</div>
          <div class="ph-size-price">{{ variant.price | money }}</div>
          {% if has_gift %}
          <div class="ph-size-gift"><i class="fas fa-gift"></i> +Free Lamp</div>
          {% endif %}
        </div>
        {% endunless %}
        {% endfor %}
      </div>

      <!-- Gift Banner — Dynamic -->
      <div class="ph-gift-banner ph-gift-banner--yes" id="ph-gift-yes">
        <div class="ph-gift-icon"><i class="fas fa-gift"></i></div>
        <div class="ph-gift-text">
          <strong>🎉 FREE Bubble Lamp Included!</strong>
          You unlocked a <span class="ph-gift-value">FREE Lamp ($60 value)</span> with your order!
        </div>
        <div class="ph-gift-ribbon">🎁</div>
      </div>

      <div class="ph-gift-banner ph-gift-banner--no" id="ph-gift-no" style="display:none;">
        <div class="ph-gift-icon ph-gift-icon--no"><i class="fas fa-gift"></i></div>
        <div class="ph-gift-text">
          <strong>😔 No Free Gift with this size</strong>
          
