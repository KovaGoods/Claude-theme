<section class="hero-section">
  <div class="hero-bg-animation">
    <div class="bubble bubble-1"></div>
    <div class="bubble bubble-2"></div>
    <div class="bubble bubble-3"></div>
    <div class="bubble bubble-4"></div>
    <div class="bubble bubble-5"></div>
  </div>
  <div class="container">
    <div class="hero-inner">

      <!-- Hero Content -->
      <div class="hero-content">
        <div class="hero-badge">
          <i class="fas fa-star"></i>
          &nbsp; #1 Sensory Lamp in the USA
        </div>
        <h1 class="hero-title">
          Bring the <span class="highlight">Ocean</span><br>
          Into Your Home
        </h1>
        <p class="hero-subtitle">
          Watch mesmerizing bubbles rise through crystal-clear water while colorful fish swim peacefully.
          The ultimate stress-relief lamp for your home, office, or kids' room.
        </p>
        <div class="hero-promo-box">
          <i class="fas fa-gift"></i>
          <span>
            Order the <strong>4ft or 5ft lamp</strong> today and get a
            <strong>FREE Bluetooth Speaker Lamp</strong> — Limited Time Only!
          </span>
        </div>
        <div class="hero-buttons">
          <a href="/collections/all" class="btn-primary">
            <i class="fas fa-shopping-bag"></i> &nbsp; Shop Now
          </a>
          <a href="#features" class="btn-secondary">
            Learn More
          </a>
        </div>
        <div class="hero-stats">
          <div class="stat">
            <span class="stat-number">500+</span>
            <span class="stat-label">Happy Customers</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-number">4.9★</span>
            <span class="stat-label">Average Rating</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-number">100%</span>
            <span class="stat-label">Free Shipping</span>
          </div>
        </div>
      </div>

      <!-- Hero Image -->
      <div class="hero-image">
        <div class="hero-image-wrapper">
          <div class="hero-glow"></div>
          {% if section.settings.hero_image != blank %}
            <img src="{{ section.settings.hero_image | img_url: '600x' }}"
                 alt="Sensory Bubble Fish Lamp"
                 class="hero-lamp-img">
          {% else %}
            <div class="hero-placeholder">
              <div class="lamp-illustration">
                <div class="lamp-body">
                  <div class="lamp-bubble lb1"></div>
                  <div class="lamp-bubble lb2"></div>
                  <div class="lamp-bubble lb3"></div>
                  <div class="lamp-fish lf1">🐠</div>
                  <div class="lamp-fish lf2">🐟</div>
                </div>
                <div class="lamp-base"></div>
              </div>
            </div>
          {% endif %}
          <div class="hero-badge-float badge-float-1">
            <i class="fas fa-leaf"></i> Stress Relief
          </div>
          <div class="hero-badge-float badge-float-2">
            <i class="fas fa-moon"></i> Night Light
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Bring the Ocean Into Your Home"
    },
    {
      "type": "textarea",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "Watch mesmerizing bubbles rise through crystal-clear water."
    }
  ],
  "presets": [
    {
      "name": "Hero Section",
      "category": "Image"
    }
  ]
}
{% endschema %}

<style>
.hero-section {
  min-height: 90vh;
  background: linear-gradient(135deg, #0D1B2A 0%, #1A2B4A 50%, #0D2B3A 100%);
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
  padding: 80px 0;
}
.hero-bg-animation {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  pointer-events: none;
}
.bubble {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0,201,200,0.15), transparent);
  animation: floatBubble linear infinite;
}
.bubble-1 { width: 80px; height: 80px; left: 10%; animation-duration: 8s; animation-delay: 0s; }
.bubble-2 { width: 50px; height: 50px; left: 25%; animation-duration: 10s; animation-delay: 2s; }
.bubble-3 { width: 100px; height: 100px; left: 60%; animation-duration: 7s; animation-delay: 1s; }
.bubble-4 { width: 40px; height: 40px; left: 75%; animation-duration: 12s; animation-delay: 3s; }
.bubble-5 { width: 70px; height: 70px; left: 85%; animation-duration: 9s; animation-delay: 0.5s; }
@keyframes floatBubble {
  0% { bottom: -100px; opacity: 0; }
  10% { opacity: 1; }
  90% { opacity: 1; }
  100% { bottom: 110%; opacity: 0; }
}
.hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}
.hero-badge {
  display: inline-block;
  background: rgba(0,201,200,0.15);
  color: var(--color-aqua);
  border: 1px solid rgba(0,201,200,0.3);
  padding: 8px 20px;
  border-radius: 50px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 1px;
  margin-bottom: 24px;
}
.hero-title {
  font-size: 56px;
  font-weight: 800;
  color: var(--color-white);
  line-height: 1.1;
  margin-bottom: 20px;
}
.hero-subtitle {
  font-size: 16px;
  color: rgba(255,255,255,0.7);
  line-height: 1.7;
  margin-bottom: 28px;
  max-width: 480px;
}
.hero-promo-box {
  background: linear-gradient(135deg, rgba(240,192,64,0.15), rgba(240,192,64,0.05));
  border: 1px solid rgba(240,192,64,0.4);
  border-radius: 12px;
  padding: 16px 20px;
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 32px;
  color: var(--color-gold);
  font-size: 14px;
  line-height: 1.5;
}
.hero-promo-box i {
  font-size: 20px;
  flex-shrink: 0;
}
.hero-buttons {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 40px;
}
.hero-stats {
  display: flex;
  align-items: center;
  gap: 24px;
}
.stat {
  display: flex;
  flex-direction: column;
}
.stat-number {
  font-size: 22px;
  font-weight: 800;
  color: var(--color-aqua);
}
.stat-label {
  font-size: 12px;
  color: rgba(255,255,255,0.5);
  letter-spacing: 0.5px;
}
.stat-divider {
  width: 1px;
  height: 40px;
  background: rgba(255,255,255,0.1);
}
.hero-image-wrapper {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}
.hero-glow {
  position: absolute;
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, rgba(0,201,200,0.2) 0%, transparent 70%);
  border-radius: 50%;
}
.hero-lamp-img {
  position: relative;
  z-index: 2;
  max-height: 500px;
  object-fit: contain;
  filter: drop-shadow(0 0 40px rgba(0,201,200,0.4));
}
.hero-placeholder {
  width: 280px;
  height: 480px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
.lamp-illustration {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.lamp-body {
  width: 120px;
  height: 360px;
  background: linear-gradient(180deg,
    rgba(0,201,200,0.1) 0%,
    rgba(0,201,200,0.3) 50%,
    rgba(0,150,200,0.2) 100%);
  border-radius: 60px;
  border: 2px solid rgba(0,201,200,0.5);
  position: relative;
  overflow: hidden;
  box-shadow: 0 0 40px rgba(0,201,200,0.3), inset 0 0 30px rgba(0,201,200,0.1);
}
.lamp-bubble {
  position: absolute;
  border-radius: 50%;
  background: rgba(0,201,200,0.6);
  animation: riseBubble 3s ease-in infinite;
}
.lb1 { width: 12px; height: 12px; left: 30%; animation-delay: 0s; }
.lb2 { width: 8px; height: 8px; left: 55%; animation-delay: 1s; }
.lb3 { width: 14px; height: 14px; left: 45%; animation-delay: 2s; }
@keyframes riseBubble {
  0% { bottom: -20px; opacity: 0; }
  20% { opacity: 1; }
  80% { opacity: 1; }
  100% { bottom: 110%; opacity: 0; }
}
.lamp-fish {
  position: absolute;
  font-size: 20px;
  animation: swimFish 4s ease-in-out infinite;
}
.lf1 { top: 40%; animation-delay: 0s; }
.lf2 { top: 60%; animation-delay: 2s; }
@keyframes swimFish {
  0% { left: 10%; transform: scaleX(1); }
  49% { left: 60%; transform: scaleX(1); }
  50% { left: 60%; transform: scaleX(-1); }
  100% { left: 10%; transform: scaleX(-1); }
}
.lamp-base {
  width: 80px;
  height: 20px;
  background: linear-gradient(135deg, #1A2B4A, #0D1B2A);
  border-radius: 0 0 40px 40px;
  border: 2px solid rgba(0,201,200,0.3);
}
.hero-badge-float {
  position: absolute;
  background: white;
  border-radius: 50px;
  padding: 10px 18px;
  font-size: 12px;
  font-weight: 700;
  color: var(--color-primary);
  box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  z-index: 10;
  animation: floatBadge 3s ease-in-out infinite;
}
.badge-float-1 {
  top: 15%;
  left: -20px;
  animation-delay: 0s;
}
.badge-float-2 {
  bottom: 20%;
  right: -20px;
  animation-delay: 1.5s;
}
.hero-badge-float i {
  color: var(--color-aqua);
  margin-right: 6px;
}
@keyframes floatBadge {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}
@media (max-width: 768px) {
  .hero-inner {
    grid-template-columns: 1fr;
    text-align: center;
  }
  .hero-title {
    font-size: 36px;
  }
  .hero-subtitle {
    max-width: 100%;
    margin: 0 auto 28px;
  }
  .hero-image {
    display: none;
  }
  .hero-buttons {
    justify-content: center;
  }
  .hero-stats {
    justify-content: center;
  }
  .hero-badge-float {
    display: none;
  }
}
</style>
