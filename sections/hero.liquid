{% assign main_product = all_products['sensory-bubble-tube-lamp-5-ft-bubble-fish-tube-sensory-aquarium-lamp-with-10-floating-fish-16-color-effects-remote-control-stress-relief-calming-light-for-bedroom-living-room-home-decor'] %}

<section class="product-hero-section">
  <div class="container">
    <div class="product-hero-grid">

      <!-- LEFT: Product Image -->
      <div class="product-hero-image-side">
        <div class="product-hero-image-wrap">
          {% if main_product.featured_image %}
            <img
              src="{{ main_product.featured_image | img_url: '800x800' }}"
              alt="{{ main_product.title }}"
              class="product-hero-img"
              id="heroProductImg"
            >
          {% endif %}
          <div class="product-hero-glow"></div>
          <div class="floating-tag tag-1">
            <i class="fas fa-fish"></i> 10 Floating Fish
          </div>
          <div class="floating-tag tag-2">
            <i class="fas fa-palette"></i> 16 Colors
          </div>
          <div class="floating-tag tag-3">
            <i class="fas fa-music"></i> Bluetooth Speaker
          </div>
        </div>

        <!-- Thumbnail Gallery -->
        <div class="product-hero-thumbs">
          {% for image in main_product.images limit: 4 %}
            <div class="thumb-item {% if forloop.first %}active{% endif %}"
                 onclick="changeHeroImage('{{ image | img_url: '800x800' }}', this)">
              <img src="{{ image | img_url: '120x120' }}" alt="Product view {{ forloop.index }}">
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- RIGHT: Product Info -->
      <div class="product-hero-info-side">
        <div class="product-hero-badge">
          <i class="fas fa-fire"></i> Limited Time Offer
        </div>

        <h2 class="product-hero-title">
          Sensory Bubble <span class="highlight">Fish Lamp</span>
        </h2>

        <p class="product-hero-desc">
          Transform any room into a calming aquatic sanctuary.
          Watch colorful fish float through mesmerizing bubbles
          with 16 stunning color effects — perfect for bedrooms,
          living rooms, and sensory spaces.
        </p>

        <!-- Rating -->
        <div class="product-hero-rating">
          <div class="stars">
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
            <i class="fas fa-star"></i>
            <i class="fas fa-star-half-alt"></i>
          </div>
          <span class="rating-text">4.8 / 5 &nbsp;·&nbsp; 127 Reviews</span>
        </div>

        <!-- Size Selector -->
        <div class="size-selector-wrap">
          <p class="size-selector-label">
            <i class="fas fa-ruler-vertical"></i> Choose Your Size:
          </p>
          <div class="size-options">

            {% for variant in main_product.variants %}
              {% unless variant.title contains '15' or variant.title contains 'Bluetooth' %}

                {% assign badge = '' %}
                {% assign is_popular = false %}
                {% if variant.title contains '48' or variant.title contains '4 ft' or variant.title contains '4ft' %}
                  {% assign badge = 'Free Gift 🎁' %}
                  {% assign is_popular = true %}
                {% endif %}
                {% if variant.title contains '60' or variant.title contains '5 ft' or variant.title contains '5ft' %}
                  {% assign badge = 'Free Gift 🎁' %}
                {% endif %}

                <div class="size-option-card {% if is_popular %}popular{% endif %}"
                     onclick="selectSize(this, '{{ main_product.url }}?variant={{ variant.id }}')"
                     data-url="{{ main_product.url }}?variant={{ variant.id }}">

                  {% if is_popular %}
                    <div class="size-popular-tag">Most Popular</div>
                  {% endif %}

                  {% if badge != '' %}
                    <div class="size-gift-badge">{{ badge }}</div>
                  {% endif %}

                  <div class="size-icon">
                    {% if variant.title contains '32' or variant.title contains '2.67' %}
                      <i class="fas fa-seedling"></i>
                    {% elsif variant.title contains '39' or variant.title contains '3.3' %}
                      <i class="fas fa-tree"></i>
                    {% elsif variant.title contains '48' or variant.title contains '4' %}
                      <i class="fas fa-water"></i>
                    {% else %}
                      <i class="fas fa-crown"></i>
                    {% endif %}
                  </div>

                  <div class="size-details">
                    <span class="size-name">{{ variant.title }}</span>
                    <span class="size-price">{{ variant.price | money }}</span>
                  </div>

                </div>

              {% endunless %}
            {% endfor %}

          </div>
        </div>

        <!-- Free Gift Notice -->
        <div class="free-gift-notice">
          <div class="gift-icon"><i class="fas fa-gift"></i></div>
          <div class="gift-text">
            <strong>FREE Bluetooth Speaker Lamp</strong> included with
            every 48" & 60" order — a $27 value, yours free!
          </div>
        </div>

        <!-- CTA Button -->
        <div class="product-hero-cta">
          <a href="{{ main_product.url }}" class="btn-primary btn-large" id="heroShopBtn">
            <i class="fas fa-shopping-bag"></i> &nbsp; Shop Now
          </a>
          <a href="#size-grid" class="btn-secondary btn-large">
            <i class="fas fa-th-large"></i> &nbsp; See All Sizes
          </a>
        </div>

        <!-- Trust Badges -->
        <div class="product-hero-trust">
          <div class="trust-item">
            <i class="fas fa-shipping-fast"></i>
            <span>Free Shipping</span>
          </div>
          <div class="trust-item">
            <i class="fas fa-shield-alt"></i>
            <span>30-Day Returns</span>
          </div>
          <div class="trust-item">
            <i class="fas fa-lock"></i>
            <span>Secure Checkout</span>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
/* ===== PRODUCT HERO SECTION ===== */
.product-hero-section {
  padding: 100px 0;
  background: linear-gradient(180deg, #f8faff 0%, #ffffff 100%);
  overflow: hidden;
}

.product-hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}

/* ===== IMAGE SIDE ===== */
.product-hero-image-side {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.product-hero-image-wrap {
  position: relative;
  border-radius: 24px;
  overflow: hidden;
  background: linear-gradient(135deg, #0D1B2A, #1A2B4A);
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 30px 80px rgba(0, 201, 200, 0.2);
}

.product-hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.product-hero-image-wrap:hover .product-hero-img {
  transform: scale(1.04);
}

.product-hero-glow {
  position: absolute;
  width: 60%;
  height: 60%;
  background: radial-gradient(circle, rgba(0,201,200,0.25), transparent);
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

/* Floating Tags */
.floating-tag {
  position: absolute;
  background: rgba(13, 27, 42, 0.85);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(0,201,200,0.3);
  color: #ffffff;
  padding: 8px 16px;
  border-radius: 50px;
  font-size: 12px;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
  animation: floatTag 3s ease-in-out infinite;
}

.floating-tag i { color: var(--color-aqua); }

.tag-1 { top: 16px; left: 16px; animation-delay: 0s; }
.tag-2 { top: 16px; right: 16px; animation-delay: 1s; }
.tag-3 { bottom: 16px; left: 50%; transform: translateX(-50%); animation-delay: 2s; }

@keyframes floatTag {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6px); }
}

.tag-3 {
  animation: floatTag3 3s ease-in-out infinite;
  animation-delay: 2s;
}

@keyframes floatTag3 {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50% { transform: translateX(-50%) translateY(-6px); }
}

/* Thumbnails */
.product-hero-thumbs {
  display: flex;
  gap: 12px;
  justify-content: center;
}

.thumb-item {
  width: 72px;
  height: 72px;
  border-radius: 12px;
  overflow: hidden;
  cursor: pointer;
  border: 2px solid transparent;
  transition: all 0.3s ease;
  opacity: 0.6;
}

.thumb-item:hover,
.thumb-item.active {
  border-color: var(--color-aqua);
  opacity: 1;
  transform: translateY(-3px);
}

.thumb-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ===== INFO SIDE ===== */
.product-hero-info-side {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.product-hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(240, 192, 64, 0.15);
  border: 1px solid rgba(240, 192, 64, 0.4);
  color: var(--color-gold);
  padding: 8px 20px;
  border-radius: 50px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  width: fit-content;
}

.product-hero-title {
  font-size: 48px;
  font-weight: 800;
  color: var(--color-primary);
  line-height: 1.15;
  margin: 0;
}

.product-hero-title .highlight {
  color: var(--color-aqua);
}

.product-hero-desc {
  font-size: 16px;
  color: var(--color-gray);
  line-height: 1.7;
  margin: 0;
}

/* Rating */
.product-hero-rating {
  display: flex;
  align-items: center;
  gap: 12px;
}

.stars { color: var(--color-gold); font-size: 16px; }

.rating-text {
  font-size: 14px;
  color: var(--color-gray);
  font-weight: 500;
}

/* ===== SIZE SELECTOR ===== */
.size-selector-wrap { display: flex; flex-direction: column; gap: 12px; }

.size-selector-label {
  font-size: 14px;
  font-weight: 700;
  color: var(--color-primary);
  text-transform: uppercase;
  letter-spacing: 1px;
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0;
}

.size-selector-label i { color: var(--color-aqua); }

.size-options {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.size-option-card {
  position: relative;
  background: var(--color-white);
  border: 2px solid #e8ecf0;
  border-radius: 16px;
  padding: 16px;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  gap: 12px;
  overflow: hidden;
}

.size-option-card:hover {
  border-color: var(--color-aqua);
  transform: translateY(-3px);
  box-shadow: 0 8px 24px rgba(0,201,200,0.15);
}

.size-option-card.popular {
  border-color: var(--color-aqua);
  background: linear-gradient(135deg, rgba(0,201,200,0.05), rgba(0,201,200,0.02));
}

.size-option-card.selected {
  border-color: var(--color-aqua);
  background: linear-gradient(135deg, rgba(0,201,200,0.1), rgba(0,201,200,0.05));
  box-shadow: 0 8px 24px rgba(0,201,200,0.2);
}

.size-popular-tag {
  position: absolute;
  top: 0;
  right: 0;
  background: var(--color-aqua);
  color: white;
  font-size: 10px;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 0 14px 0 10px;
  letter-spacing: 0.5px;
}

.size-gift-badge {
  position: absolute;
  bottom: 6px;
  right: 8px;
  font-size: 10px;
  font-weight: 700;
  color: var(--color-gold);
}

.size-icon {
  width: 40px;
  height: 40px;
  background: linear-gradient(135deg, var(--color-aqua), #0099CC);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 16px;
  flex-shrink: 0;
}

.size-details {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.size-name {
  font-size: 13px;
  font-weight: 700;
  color: var(--color-primary);
}

.size-price {
  font-size: 16px;
  font-weight: 800;
  color: var(--color-aqua);
}

/* Free Gift Notice */
.free-gift-notice {
  display: flex;
  align-items: center;
  gap: 16px;
  background: linear-gradient(135deg, rgba(240,192,64,0.1), rgba(240,192,64,0.05));
  border: 1px solid rgba(240,192,64,0.3);
  border-radius: 16px;
  padding: 16px 20px;
}

.gift-icon {
  width: 44px;
  height: 44px;
  background: linear-gradient(135deg, var(--color-gold), #e8a800);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 20px;
  flex-shrink: 0;
}

.gift-text {
  font-size: 14px;
  color: var(--color-primary);
  line-height: 1.5;
}

/* CTA Buttons */
.product-hero-cta {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
}

.btn-large {
  padding: 16px 32px !important;
  font-size: 15px !important;
}

/* Trust Badges */
.product-hero-trust {
  display: flex;
  gap: 24px;
  padding-top: 8px;
  border-top: 1px solid #e8ecf0;
  flex-wrap: wrap;
}

.trust-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: var(--color-gray);
  font-weight: 500;
}

.trust-item i {
  color: var(--color-aqua);
  font-size: 16px;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 1024px) {
  .product-hero-grid {
    grid-template-columns: 1fr;
    gap: 48px;
  }
  .product-hero-title { font-size: 38px; }
}

@media (max-width: 768px) {
  .product-hero-section { padding: 60px 0; }
  .product-hero-title { font-size: 32px; }
  .size-options { grid-template-columns: 1fr 1fr; }
  .product-hero-cta { flex-direction: column; }
  .product-hero-trust { gap: 16px; }
}
</style>

<script>
function changeHeroImage(src, el) {
  document.getElementById('heroProductImg').src = src;
  document.querySelectorAll('.thumb-item').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
}

function selectSize(el, url) {
  document.querySelectorAll('.size-option-card').forEach(c => c.classList.remove('selected'));
  el.classList.add('selected');
  document.getElementById('heroShopBtn').href = url;
}
</script>

{% schema %}
{
  "name": "Product Hero",
  "settings": [],
  "presets": [
    {
      "name": "Product Hero"
    }
  ]
}
{% endschema %}
