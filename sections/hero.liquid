<section class="product-hero">
  <div class="ph-bg">
    <div class="ph-glow ph-glow-1"></div>
    <div class="ph-glow ph-glow-2"></div>
    <div class="ph-bubbles">
      {% for i in (1..10) %}
        <div class="ph-bubble ph-bubble-{{ i }}"></div>
      {% endfor %}
    </div>
  </div>

  <div class="container">
    <div class="ph-layout">

      <!-- LEFT: Info -->
      <div class="ph-info">

        <div class="ph-badge">
          <i class="fas fa-star"></i> #1 Sensory Lamp in the USA
        </div>

        <h1 class="ph-title">
          Transform Any Room Into A
          <span class="ph-highlight">Calming Oasis</span>
        </h1>

        <p class="ph-subtitle">
          Watch colorful bubbles dance with real fish as your stress melts away.
          The ultimate sensory experience — for your home, office, or bedroom.
        </p>

        <!-- Quick Features -->
        <ul class="ph-features">
          <li><i class="fas fa-check-circle"></i> Color-changing LED lights</li>
          <li><i class="fas fa-check-circle"></i> Real fish aquarium effect</li>
          <li><i class="fas fa-check-circle"></i> 4 sizes — 2.67ft to 5ft</li>
          <li><i class="fas fa-check-circle"></i> Free USA shipping always</li>
        </ul>

        <!-- Price + CTA -->
        <div class="ph-cta-block">
          <div class="ph-price-wrap">
            <span class="ph-price-from">From</span>
            <span class="ph-price">$89.99</span>
            <span class="ph-price-old">$129.99</span>
            <span class="ph-price-save">Save 30%</span>
          </div>

          <div class="ph-buttons">
            <a href="/collections/all" class="btn-primary ph-btn-main">
              <i class="fas fa-shopping-bag"></i> Shop Now
            </a>
            <a href="#product-details" class="ph-btn-ghost">
              <i class="fas fa-play-circle"></i> See How It Works
            </a>
          </div>
        </div>

        <!-- Promo Gift -->
        <div class="ph-promo-note">
          🎁 <strong>FREE Bluetooth Lamp</strong> with every 4ft or 5ft order — Limited time!
        </div>

        <!-- Social Proof -->
        <div class="ph-social-proof">
          <div class="ph-avatars">
            <div class="ph-avatar" style="background: #E8A87C">S</div>
            <div class="ph-avatar" style="background: #85C1E9">M</div>
            <div class="ph-avatar" style="background: #A9DFBF">J</div>
            <div class="ph-avatar" style="background: #F1948A">K</div>
          </div>
          <div class="ph-proof-text">
            <div class="ph-stars">★★★★★</div>
            <span>2,400+ happy customers</span>
          </div>
        </div>

      </div>

      <!-- RIGHT: Product Visual -->
      <div class="ph-visual">

        <div class="ph-product-wrap">

          <!-- Glow behind product -->
          <div class="ph-product-glow"></div>

          <!-- Main Product Image -->
          <div class="ph-product-img-container">
            {% assign hero_product = all_products['sensory-bubble-tube-lamp'] %}
            {% if hero_product and hero_product.featured_image %}
              <img
                src="{{ hero_product.featured_image | img_url: '800x800' }}"
                alt="{{ hero_product.title }}"
                class="ph-product-img"
              >
            {% else %}
              <!-- Placeholder when no product image -->
              <div class="ph-product-placeholder">
                <div class="ph-lamp-visual">
                  <div class="ph-lamp-tube">
                    <div class="ph-lamp-bubbles">
                      <div class="ph-lb ph-lb-1"></div>
                      <div class="ph-lb ph-lb-2"></div>
                      <div class="ph-lb ph-lb-3"></div>
                      <div class="ph-lb ph-lb-4"></div>
                      <div class="ph-lb ph-lb-5"></div>
                    </div>
                    <div class="ph-lamp-fish">🐠</div>
                    <div class="ph-lamp-fish ph-fish-2">🐡</div>
                  </div>
                  <div class="ph-lamp-base"></div>
                </div>
              </div>
            {% endif %}
          </div>

          <!-- Floating Tags -->
          <div class="ph-tag ph-tag-1">
            <i class="fas fa-leaf"></i>
            <div>
              <strong>Stress Relief</strong>
              <span>Proven calming effect</span>
            </div>
          </div>

          <div class="ph-tag ph-tag-2">
            <i class="fas fa-palette"></i>
            <div>
              <strong>16 Colors</strong>
              <span>LED color changing</span>
            </div>
          </div>

          <div class="ph-tag ph-tag-3">
            <i class="fas fa-gift"></i>
            <div>
              <strong>Free Gift</strong>
              <span>Bluetooth lamp included</span>
            </div>
          </div>

        </div>

        <!-- Size Selector Preview -->
        <div class="ph-size-preview">
          <span class="ph-size-label">Choose Size:</span>
          <div class="ph-sizes">
            <a href="/collections/all?variant=2.67ft" class="ph-size-btn">2.67ft</a>
            <a href="/collections/all?variant=3.3ft"  class="ph-size-btn">3.3ft</a>
            <a href="/collections/all?variant=4ft"    class="ph-size-btn ph-size-popular">4ft ⭐</a>
            <a href="/collections/all?variant=5ft"    class="ph-size-btn">5ft</a>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>


<style>
/* =====================
   PRODUCT HERO BASE
   ===================== */
.product-hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #0D1B2A 0%, #1A2B4A 55%, #0D3B4A 100%);
  overflow: hidden;
  padding: 120px 0 80px;
}

/* Background */
.ph-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}
.ph-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(120px);
  opacity: 0.25;
}
.ph-glow-1 {
  width: 600px; height: 600px;
  background: var(--color-aqua);
  top: -150px; right: -100px;
}
.ph-glow-2 {
  width: 400px; height: 400px;
  background: #7B2FBE;
  bottom: -100px; left: -80px;
}

/* Bubbles */
.ph-bubbles { position: absolute; inset: 0; }
.ph-bubble {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(0,201,200,0.15);
  animation: phBubbleRise linear infinite;
}
.ph-bubble-1  { width:14px; height:14px; left:5%;  bottom:-20px; animation-duration:9s;  animation-delay:0s;   }
.ph-bubble-2  { width:8px;  height:8px;  left:15%; bottom:-20px; animation-duration:7s;  animation-delay:1s;   }
.ph-bubble-3  { width:20px; height:20px; left:22%; bottom:-20px; animation-duration:11s; animation-delay:2s;   }
.ph-bubble-4  { width:10px; height:10px; left:35%; bottom:-20px; animation-duration:8s;  animation-delay:0.5s; }
.ph-bubble-5  { width:16px; height:16px; left:48%; bottom:-20px; animation-duration:10s; animation-delay:3s;   }
.ph-bubble-6  { width:6px;  height:6px;  left:58%; bottom:-20px; animation-duration:6s;  animation-delay:1.5s; }
.ph-bubble-7  { width:22px; height:22px; left:68%; bottom:-20px; animation-duration:12s; animation-delay:2.5s; }
.ph-bubble-8  { width:12px; height:12px; left:75%; bottom:-20px; animation-duration:8s;  animation-delay:4s;   }
.ph-bubble-9  { width:18px; height:18px; left:82%; bottom:-20px; animation-duration:9s;  animation-delay:1s;   }
.ph-bubble-10 { width:9px;  height:9px;  left:92%; bottom:-20px; animation-duration:7s;  animation-delay:3.5s; }

@keyframes phBubbleRise {
  0%   { transform: translateY(0) scale(1);    opacity: 0.5; }
  100% { transform: translateY(-105vh) scale(0.3); opacity: 0; }
}

/* =====================
   LAYOUT
   ===================== */
.ph-layout {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}

/* =====================
   LEFT — INFO
   ===================== */
.ph-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(0,201,200,0.12);
  border: 1px solid rgba(0,201,200,0.3);
  color: var(--color-aqua);
  padding: 8px 18px;
  border-radius: 50px;
  font-size: 13px;
  font-weight: 700;
  margin-bottom: 24px;
  letter-spacing: 0.5px;
}
.ph-badge i { font-size: 12px; color: #F0C040; }

.ph-title {
  font-size: clamp(32px, 4vw, 52px);
  font-weight: 800;
  color: var(--color-white);
  line-height: 1.15;
  margin-bottom: 20px;
}
.ph-highlight {
  background: linear-gradient(135deg, var(--color-aqua), #7B2FBE);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.ph-subtitle {
  font-size: 17px;
  color: rgba(255,255,255,0.65);
  line-height: 1.7;
  margin-bottom: 28px;
  max-width: 480px;
}

/* Features List */
.ph-features {
  list-style: none;
  margin: 0 0 32px;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.ph-features li {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  color: rgba(255,255,255,0.75);
  font-weight: 500;
}
.ph-features li i {
  color: var(--color-aqua);
  font-size: 14px;
  flex-shrink: 0;
}

/* Price */
.ph-cta-block { margin-bottom: 20px; }
.ph-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 10px;
  margin-bottom: 20px;
  flex-wrap: wrap;
}
.ph-price-from {
  font-size: 14px;
  color: rgba(255,255,255,0.5);
  font-weight: 500;
}
.ph-price {
  font-size: 44px;
  font-weight: 800;
  color: var(--color-white);
  line-height: 1;
}
.ph-price-old {
  font-size: 20px;
  color: rgba(255,255,255,0.35);
  text-decoration: line-through;
}
.ph-price-save {
  background: #E74C3C;
  color: white;
  padding: 4px 10px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 700;
}

/* Buttons */
.ph-buttons {
  display: flex;
  gap: 16px;
  align-items: center;
  flex-wrap: wrap;
}
.ph-btn-main {
  padding: 16px 36px;
  font-size: 16px;
}
.ph-btn-ghost {
  display: flex;
  align-items: center;
  gap: 8px;
  color: rgba(255,255,255,0.7);
  font-size: 15px;
  font-weight: 600;
  transition: var(--transition);
}
.ph-btn-ghost:hover { color: var(--color-aqua); }
.ph-btn-ghost i { font-size: 20px; }

/* Promo Note */
.ph-promo-note {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(240,192,64,0.1);
  border: 1px solid rgba(240,192,64,0.25);
  color: #F0C040;
  padding: 10px 18px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 24px;
  line-height: 1.5;
}

/* Social Proof */
.ph-social-proof {
  display: flex;
  align-items: center;
  gap: 14px;
}
.ph-avatars {
  display: flex;
}
.ph-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 2px solid #0D1B2A;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  color: white;
  margin-left: -8px;
}
.ph-avatars .ph-avatar:first-child { margin-left: 0; }
.ph-proof-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.ph-stars {
  color: #F0C040;
  font-size: 14px;
  letter-spacing: 1px;
}
.ph-proof-text span {
  font-size: 13px;
  color: rgba(255,255,255,0.55);
  font-weight: 500;
}

/* =====================
   RIGHT — VISUAL
   ===================== */
.ph-visual {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24px;
}

.ph-product-wrap {
  position: relative;
  width: 100%;
  max-width: 480px;
}

.ph-product-glow {
  position: absolute;
  width: 70%;
  height: 70%;
  background: radial-gradient(circle, rgba(0,201,200,0.35), transparent 70%);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  filter: blur(40px);
  z-index: 0;
  animation: phGlowPulse 4s ease-in-out infinite;
}
@keyframes phGlowPulse {
  0%, 100% { opacity: 0.7; transform: translate(-50%,-50%) scale(1);   }
  50%       { opacity: 1;   transform: translate(-50%,-50%) scale(1.15); }
}

.ph-product-img-container {
  position: relative;
  z-index: 1;
  border-radius: 24px;
  overflow: hidden;
  box-shadow:
    0 40px 80px rgba(0,0,0,0.5),
    0 0 60px rgba(0,201,200,0.2);
  animation: phFloat 6s ease-in-out infinite;
}
@keyframes phFloat {
  0%, 100% { transform: translateY(0px); }
  50%       { transform: translateY(-16px); }
}

.ph-product-img {
  width: 100%;
  display: block;
  border-radius: 24px;
}

/* Placeholder Lamp Visual */
.ph-product-placeholder {
  width: 100%;
  aspect-ratio: 3/4;
  background: linear-gradient(180deg, rgba(0,201,200,0.05) 0%, rgba(0,0,0,0.2) 100%);
  border-radius: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ph-lamp-visual {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  height: 80%;
}
.ph-lamp-tube {
  width: 80px;
  flex: 1;
  background: linear-gradient(180deg,
    rgba(0,201,200,0.6) 0%,
    rgba(123,47,190,0.4) 50%,
    rgba(0,201,200,0.6) 100%);
  border-radius: 40px 40px 0 0;
  position: relative;
  overflow: hidden;
  box-shadow: 0 0 40px rgba(0,201,200,0.5), inset 0 0 20px rgba(255,255,255,0.1);
  animation: lampGlow 3s ease-in-out infinite;
}
@keyframes lampGlow {
  0%, 100% { box-shadow: 0 0 40px rgba(0,201,200,0.5), inset 0 0 20px rgba(255,255,255,0.1); }
  50%       { box-shadow: 0 0 70px rgba(123,47,190,0.7), inset 0 0 30px rgba(255,255,255,0.15); }
}
.ph-lamp-bubbles { position: absolute; width: 100%; height: 100%; }
.ph-lb {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,0.4);
  animation: lbRise linear infinite;
}
.ph-lb-1 { width:8px;  height:8px;  left:20%; bottom:5%;  animation-duration:3s;   animation-delay:0s;   }
.ph-lb-2 { width:5px;  height:5px;  left:50%; bottom:10%; animation-duration:2.5s; animation-delay:0.5s; }
.ph-lb-3 { width:10px; height:10px; left:70%; bottom:0%;  animation-duration:4s;   animation-delay:1s;   }
.ph-lb-4 { width:6px;  height:6px;  left:35%; bottom:20%; animation-duration:3.5s; animation-delay:1.5s; }
.ph-lb-5 { width:4px;  height:4px;  left:80%; bottom:15%; animation-duration:2s;   animation-delay:2s;   }
@keyframes lbRise {
  0%   { transform: translateY(0);    opacity: 0.8; }
  100% { transform: translateY(-200px); opacity: 0;   }
}
.ph-lamp-fish {
  position: absolute;
  font-size: 22px;
  animation: fishSwimTube 4s ease-in-out infinite;
  top: 40%;
  left: 50%;
  transform: translateX(-50%);
}
.ph-fish-2 {
  font-size: 16px;
  top: 65%;
  animation-delay: 2s;
  animation-duration: 5s;
}
@keyframes fishSwimTube {
  0%, 100% { transform: translateX(-50%) translateY(0);    }
  50%       { transform: translateX(-50%) translateY(-30px); }
}
.ph-lamp-base {
  width: 100px;
  height: 16px;
  background: rgba(255,255,255,0.1);
  border-radius: 0 0 8px 8px;
}

/* Floating Tags */
.ph-tag {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(13,27,42,0.85);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 14px;
  padding: 12px 16px;
  z-index: 3;
  box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  animation: phTagFloat ease-in-out infinite;
  white-space: nowrap;
}
.ph-tag i {
  font-size: 20px;
  color: var(--color-aqua);
  flex-shrink: 0;
}
.ph-tag div {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.ph-tag strong {
  font-size: 13px;
  font-weight: 700;
  color: var(--color-white);
}
.ph-tag span {
  font-size: 11px;
  color: rgba(255,255,255,0.5);
}
.ph-tag-1 {
  top: 12%;
  left: -20px;
  animation-duration: 5s;
  animation-delay: 0s;
}
.ph-tag-2 {
  top: 48%;
  right: -20px;
  animation-duration: 6s;
  animation-delay: 1s;
}
.ph-tag-3 {
  bottom: 18%;
  left: -10px;
  animation-duration: 4.5s;
  animation-delay: 2s;
}
@keyframes phTagFloat {
  0%, 100% { transform: translateY(0);   }
  50%       { transform: translateY(-8px); }
}

/* Size Selector */
.ph-size-preview {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  justify-content: center;
}
.ph-size-label {
  font-size: 13px;
  color: rgba(255,255,255,0.5);
  font-weight: 600;
}
.ph-sizes {
  display: flex;
  gap: 8px;
}
.ph-size-btn {
  padding: 8px 16px;
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 8px;
  color: rgba(255,255,255,0.7);
  font-size: 13px;
  font-weight: 600;
  transition: var(--transition);
  background: rgba(255,255,255,0.04);
}
.ph-size-btn:hover {
  border-color: var(--color-aqua);
  color: var(--color-aqua);
  background: rgba(0,201,200,0.08);
}
.ph-size-popular {
  border-color: var(--color-aqua) !important;
  color: var(--color-aqua) !important;
  background: rgba(0,201,200,0.1) !important;
}

/* =====================
   RESPONSIVE
   ===================== */
@media (max-width: 1024px) {
  .ph-layout {
    grid-template-columns: 1fr;
    text-align: center;
  }
  .ph-features { justify-items: center; }
  .ph-buttons  { justify-content: center; }
  .ph-social-proof { justify-content: center; }
  .ph-promo-note { justify-content: center; }
  .ph-visual { order: -1; }
  .ph-product-wrap { max-width: 360px; }
  .ph-tag-1 { left: 0; }
  .ph-tag-3 { left: 0; }
}

@media (max-width: 600px) {
  .product-hero { padding: 100px 0 60px; }
  .ph-features  { grid-template-columns: 1fr; }
  .ph-tag       { display: none; }
  .ph-price     { font-size: 36px; }
  .ph-product-wrap { max-width: 280px; }
}
</style>
