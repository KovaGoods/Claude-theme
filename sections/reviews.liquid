.rv-star-picker { display:flex; gap:8px; }
.rv-sp-star { background:none; border:none; font-size:28px; color:rgba(255,255,255,0.2); cursor:pointer; transition:all 0.2s; padding:0; line-height:1; }
.rv-sp-star:hover, .rv-sp-star--active { color:#f0c040; transform:scale(1.2); }

/* Rating Error */
.rv-rating-error {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #ff4d6d;
  font-size: 13px;
  font-weight: 600;
  background: rgba(255,77,109,0.1);
  border: 1px solid rgba(255,77,109,0.3);
  border-radius: 10px;
  padding: 10px 16px;
}

.rv-submit-btn {
  display:flex; align-items:center; justify-content:center; gap:10px;
  background:linear-gradient(135deg,#00c9c8,#0099cc); color:white;
  font-size:16px; font-weight:800; padding:18px 32px; border-radius:16px;
  border:none; cursor:pointer; transition:all 0.3s;
  box-shadow:0 8px 32px rgba(0,201,200,0.3); align-self:flex-start;
}
.rv-submit-btn:hover { transform:translateY(-3px); box-shadow:0 16px 48px rgba(0,201,200,0.5); }

.rv-success {
  flex-direction:column; align-items:center; text-align:center;
  padding:60px 20px; gap:16px;
}
.rv-success-icon { font-size:60px; color:#22c55e; animation:rvBounce 0.6s ease; }
@keyframes rvBounce { 0%{transform:scale(0)} 70%{transform:scale(1.2)} 100%{transform:scale(1)} }
.rv-success h3 { font-size:24px; font-weight:900; color:#fff; }
.rv-success p  { font-size:14px; color:rgba(255,255,255,0.5); max-width:400px; }

/* ════════ RESPONSIVE ════════ */
@media (max-width: 768px) {
  .rv-hero   { padding: 60px 20px 40px; }
  .rv-main   { padding: 32px 20px 60px; }
  .rv-write  { padding: 32px 20px; }
  .rv-form-row { grid-template-columns: 1fr; }
  .rv-grid   { grid-template-columns: 1fr; }
  .rv-controls { flex-direction: column; align-items: stretch; }
  .rv-hero-stats { gap: 24px; }
  .rv-stat-divider { display: none; }
  .rv-scroll-btn { font-size: 14px; padding: 12px 24px; }
}
</style>

