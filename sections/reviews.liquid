// ════════════════════════════════
// STATE
// ════════════════════════════════
let rvFiltered    = [...RV_DATA];
let rvPage        = 1;
const RV_PER_PAGE = 12;
let rvStarSelected= 0;
let rvActiveFilter= 'all';
let rvNextId      = RV_DATA.length + 1;

// ════════════════════════════════
// SCROLL
// ════════════════════════════════
function rvScrollToGrid(e) {
  e.preventDefault();
  const target = document.getElementById('rv-grid-anchor');
  if (target) target.scrollIntoView({ behavior:'smooth', block:'start' });
}

// ════════════════════════════════
// RENDER
// ════════════════════════════════
function rvRender() {
  const grid = document.getElementById('rv-grid');
  if (!grid) return;
  const start = (rvPage - 1) * RV_PER_PAGE;
  const page  = rvFiltered.slice(start, start + RV_PER_PAGE);

  if (page.length === 0) {
    grid.innerHTML = '<div class="rv-empty"><i class="fas fa-search"></i><p>No reviews found.</p></div>';
    rvRenderPagination();
    return;
  }

  grid.innerHTML = page.map(r => `
    <div class="rv-card ${r.isNew ? 'rv-card--new' : ''}" data-rating="${r.rating}">
      ${r.isNew ? '<div class="rv-card-new-badge"><i class="fas fa-sparkles"></i> Just Added</div>' : ''}
      <div class="rv-card-top">
        <div class="rv-card-avatar" style="${r.isNew ? 'background:linear-gradient(135deg,#f0c040,#f59e0b)' : ''}">${r.name.charAt(0)}</div>
        <div class="rv-card-meta">
          <div class="rv-card-name">
            ${r.name}
            ${r.verified ? '<span class="rv-verified"><i class="fas fa-check-circle"></i> Verified</span>' : ''}
            ${r.isNew ? '<span class="rv-new-tag">New</span>' : ''}
          </div>
          <div class="rv-card-loc"><i class="fas fa-map-marker-alt"></i> ${r.loc}</div>
        </div>
        <div class="rv-card-date">${rvFormatDate(r.date)}</div>
      </div>
      <div class="rv-card-stars">${rvStars(r.rating)}</div>
      <div class="rv-card-title">${r.title}</div>
      <div class="rv-card-body">${r.body}</div>
      <div class="rv-card-footer">
        ${r.size ? `<span class="rv-card-size"><i class="fas fa-ruler"></i> ${r.size}</span>` : ''}
        <button class="rv-helpful-btn" onclick="rvHelpful(${r.id}, this)">
          <i class="fas fa-thumbs-up"></i> Helpful (${r.helpful})
        </button>
      </div>
    </div>
  `).join('');

  rvRenderPagination();
}

function rvStars(n) {
  let s = '';
  for (let i = 1; i <= 5; i++) {
    if (i <= n)       s += '<i class="fas fa-star"></i>';
    else if (i-0.5<=n)s += '<i class="fas fa-star-half-alt"></i>';
    else              s += '<i class="far fa-star"></i>';
  }
  return s;
}

function rvFormatDate(d) {
  return new Date(d).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'});
}

// ════════════════════════════════
// PAGINATION
// ════════════════════════════════
function rvRenderPagination() {
  const total = Math.ceil(rvFiltered.length / RV_PER_PAGE);
  const pg = document.getElementById('rv-pagination');
  if (!pg || total <= 1) { if (pg) pg.innerHTML=''; return; }

  let html = '';
  if (rvPage > 1) html += `<button class="rv-pg-btn" onclick="rvGoPage(${rvPage-1})"><i class="fas fa-chevron-left"></i></button>`;
  const start = Math.max(1, rvPage-2);
  const end   = Math.min(total, rvPage+2);
  if (start > 1) html += `<button class="rv-pg-btn" onclick="rvGoPage(1)">1</button>${start>2?'<span class="rv-pg-dots">…</span>':''}`;
  for (let i = start; i <= end; i++) {
    html += `<button class="rv-pg-btn ${i===rvPage?'rv-pg-btn--active':''}" onclick="rvGoPage(${i})">${i}</button>`;
  }
  if (end < total) html += `${end<total-1?'<span class="rv-pg-dots">…</span>':''}<button class="rv-pg-btn" onclick="rvGoPage(${total})">${total}</button>`;
  if (rvPage < total) html += `<button class="rv-pg-btn" onclick="rvGoPage(${rvPage+1})"><i class="fas fa-chevron-right"></i></button>`;
  pg.innerHTML = html;
}

function rvGoPage(n) {
  rvPage = n;
  rvRender();
  const anchor = document.getElementById('rv-grid-anchor');
  if (anchor) anchor.scrollIntoView({ behavior:'smooth', block:'start' });
}

// ════════════════════════════════
// FILTER & SORT
// ════════════════════════════════
function rvApply() {
  const q    = (document.getElementById('rv-search')?.value || '').toLowerCase();
  const sort = document.getElementById('rv-sort')?.value || 'newest';

  rvFiltered = RV_DATA.filter(r => {
    const matchFilter = rvActiveFilter === 'all' || r.rating === parseInt(rvActiveFilter);
    const matchSearch = !q || r.title.toLowerCase().includes(q) || r.body.toLowerCase().includes(q) || r.name.toLowerCase().includes(q);
    return matchFilter && matchSearch;
  });

  if (sort === 'newest')  rvFiltered.sort((a,b) => {
    // New reviews always first
    if (a.isNew && !b.isNew) return -1;
    if (!a.isNew && b.isNew) return 1;
    return new Date(b.date) - new Date(a.date);
  });
  if (sort === 'highest') rvFiltered.sort((a,b) => b.rating - a.rating);
  if (sort === 'lowest')  rvFiltered.sort((a,b) => a.rating - b.rating);
  if (sort === 'helpful') rvFiltered.sort((a,b) => b.helpful - a.helpful);

  rvPage = 1;
  rvRender();

  // Update filter buttons count
  rvUpdateFilterCounts();
}

function rvUpdateFilterCounts() {
  const total = RV_DATA.length;
  const five  = RV_DATA.filter(r=>r.rating===5).length;
  const four  = RV_DATA.filter(r=>r.rating===4).length;
  const three = RV_DATA.filter(r=>r.rating===3).length;
  const btns  = document.querySelectorAll('.rv-filter-btn');
  if (btns[0]) btns[0].textContent = `All (${total})`;
  if (btns[1]) btns[1].textContent = `⭐⭐⭐⭐⭐ (${five})`;
  if (btns[2]) btns[2].textContent = `⭐⭐⭐⭐ (${four})`;
  if (btns[3]) btns[3].textContent = `⭐⭐⭐ (${three})`;
}

function rvFilter() { rvApply(); }
function rvSort()   { rvApply(); }

function rvSetFilter(val, btn) {
  rvActiveFilter = val;
  document.querySelectorAll('.rv-filter-btn').forEach(b => b.classList.remove('rv-filter-btn--active'));
  btn.classList.add('rv-filter-btn--active');
  rvApply();
}

// ════════════════════════════════
// HELPFUL
// ════════════════════════════════
function rvHelpful(id, btn) {
  const r = RV_DATA.find(x => x.id === id);
  if (!r || btn.dataset.voted) return;
  r.helpful++;
  btn.innerHTML = `<i class="fas fa-thumbs-up"></i> Helpful (${r.helpful})`;
  btn.dataset.voted = '1';
  btn.style.color = '#00c9c8';
}

// ════════════════════════════════
// STAR PICKER
// ════════════════════════════════
function rvPickStar(val) {
  rvStarSelected = val;
  document.getElementById('rv-rating-val').value = val;
  document.querySelectorAll('.rv-sp-star').forEach((btn, i) => {
    btn.classList.toggle('rv-sp-star--active', i < val);
  });
  // Hide error if shown
  const err = document.getElementById('rv-rating-error');
  if (err) err.style.display = 'none';
}

// ════════════════════════════════
// ✅ SUBMIT — يضيف الريفيو للـ Grid فوراً
// ════════════════════════════════
function rvSubmit(e) {
  e.preventDefault();

  // Validate rating
  if (rvStarSelected === 0) {
    const err = document.getElementById('rv-rating-error');
    if (err) err.style.display = 'flex';
    return;
  }

  // Collect data
  const name  = document.getElementById('rv-name').value.trim();
  const title = document.getElementById('rv-title-input').value.trim();
  const body  = document.getElementById('rv-body').value.trim();
  const size  = document.getElementById('rv-size').value;
  const today = new Date().toISOString().split('T')[0];

  // ✅ Create new review object
  const newReview = {
    id:       rvNextId++,
    name:     name,
    loc:      "Verified Buyer",
    rating:   rvStarSelected,
    title:    title,
    body:     body,
    size:     size || null,
    date:     today,
    helpful:  0,
    verified: true,
    isNew:    true   // ← علامة إنه ريفيو جديد
  };

  // ✅ Add to beginning of data array
  RV_DATA.unshift(newReview);

  // ✅ Show success message
  document.getElementById('rv-form').style.display = 'none';
  document.getElementById('rv-success').style.display = 'flex';

  // ✅ Update total count in hero
  const countEl = document.getElementById('rv-total-count');
  if (countEl) countEl.textContent = RV_DATA.length;

  // ✅ Reset filter to "All" and sort to "Newest"
  rvActiveFilter = 'all';
  document.querySelectorAll('.rv-filter-btn').forEach(b => b.classList.remove('rv-filter-btn--active'));
  document.querySelector('.rv-filter-btn')?.classList.add('rv-filter-btn--active');
  const sortEl = document.getElementById('rv-sort');
  if (sortEl) sortEl.value = 'newest';

  // ✅ Re-render grid — الريفيو هيظهر أول حاجة
  rvApply();

  // ✅ Show banner notification
  const banner = document.getElementById('rv-new-banner');
  const bannerText = document.getElementById('rv-new-banner-text');
  if (banner && bannerText) {
    bannerText.textContent = `✨ "${title}" has been added to the reviews!`;
    banner.style.display = 'flex';
    // Auto-hide after 5 seconds
    setTimeout(() => { banner.style.display = 'none'; }, 5000);
  }

  // ✅ Scroll to grid to show new review
  setTimeout(() => {
    const anchor = document.getElementById('rv-grid-anchor');
    if (anchor) anchor.scrollIntoView({ behavior:'smooth', block:'start' });
  }, 300);
}

// ════════════════════════════════
// WRITE ANOTHER
// ════════════════════════════════
function rvWriteAnother() {
  // Reset form
  document.getElementById('rv-form').reset();
  document.getElementById('rv-form').style.display = 'flex';
  document.getElementById('rv-success').style.display = 'none';
  rvStarSelected = 0;
  document.getElementById('rv-rating-val').value = '0';
  document.querySelectorAll('.rv-sp-star').forEach(btn => btn.classList.remove('rv-sp-star--active'));
  document.getElementById('rv-char-count').textContent = '0 / 500';
}

// ════════════════════════════════
// INIT
// ════════════════════════════════
document.addEventListener('DOMContentLoaded', () => {
  // Char count
  const ta = document.getElementById('rv-body');
  const cc = document.getElementById('rv-char-count');
  if (ta && cc) {
    ta.addEventListener('input', () => {
      const len = ta.value.length;
      cc.textContent = len + ' / 500';
      cc.style.color = len > 450 ? '#ff4d6d' : 'rgba(255,255,255,0.3)';
      if (len > 500) ta.value = ta.value.slice(0, 500);
    });
  }

  // Init
  rvApply();
});
</script>


