<section class="size-selector-section">
  <div class="size-selector-container">
    
    <div class="size-selector-header">
      <h2>Choose Your Perfect Size</h2>
      <p>Find the ideal Bubble Tube Lamp for your space</p>
    </div>

    <div class="size-cards-grid">

      {% assign product_handle = 'sensory-bubble-tube-lamp-5-ft-bubble-fish-tube-sensory-aquarium-lamp-with-10-floating-fish-16-color-effects-remote-control-stress-relief-calming-light-for-bedroom-living-room-home-decor' %}
      {% assign product = all_products[product_handle] %}

      {% for variant in product.variants %}
        {% if variant.title != '15 inch' %}

        <a href="/products/{{ product_handle }}?variant={{ variant.id }}" class="size-card {% if variant.title == '48 inch' or variant.title == '60 inch' %}has-gift{% endif %}">
          
          <div class="size-card-badge">
            {% if variant.title == '32 inch' %}
              <span class="badge starter">Starter</span>
            {% elsif variant.title == '39 inch' %}
              <span class="badge popular">Most Popular</span>
            {% elsif variant.title == '48 inch' %}
              <span class="badge bestseller">Best Value</span>
            {% elsif variant.title == '60 inch' %}
              <span class="badge premium">Premium</span>
            {% endif %}
          </div>

          <div class="size-card-visual">
            <div class="lamp-icon" style="height: {% if variant.title == '32 inch' %}60px{% elsif variant.title == '39 inch' %}80px{% elsif variant.title == '48 inch' %}100px{% else %}120px{% endif %};">
              <div class="lamp-body"></div>
              <div class="lamp-glow"></div>
            </div>
          </div>

          <div class="size-card-info">
            <h3 class="size-title">{{ variant.title }}</h3>
            <p class="size-price">${{ variant.price | money_without_currency }}</p>
            <p class="size-desc">
              {% case variant.title %}
                {% when '32 inch' %}Ideal for bedrooms & offices
                {% when '39 inch' %}Great for living rooms
                {% when '48 inch' %}Statement piece for any room
                {% when '60 inch' %}Ultimate floor-to-ceiling impact
              {% endcase %}
            </p>

            {% if variant.title == '48 inch' or variant.title == '60 inch' %}
              <div class="gift-tag">
                🎁 Free 15" Lamp Included!
              </div>
            {% endif %}
          </div>

          <div class="size-card-cta">
            <span class="cta-btn">Shop {{ variant.title }} →</span>
          </div>

        </a>

        {% endif %}
      {% endfor %}

    </div>

    <div class="size-selector-footer">
      <p>🎁 <strong>Free 15" Bluetooth Lamp</strong> included with every 48" & 60" order!</p>
    </div>

  </div>
</section>

<style>
.size-selector-section {
  background: linear-gradient(180deg, #0a0f1e 0%, #0d1b2a 100%);
  padding: 80px 20px;
  font-family: 'Inter', sans-serif;
}

.size-selector-container {
  max-width: 1200px;
  margin: 0 auto;
}

.size-selector-header {
  text-align: center;
  margin-bottom: 50px;
}

.size-selector-header h2 {
  font-size: 2.5rem;
  color: #ffffff;
  margin-bottom: 12px;
  font-weight: 700;
}

.size-selector-header p {
  font-size: 1.1rem;
  color: #7ecfff;
  opacity: 0.8;
}

.size-cards-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 40px;
}

.size-card {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(126,207,255,0.15);
  border-radius: 16px;
  padding: 24px 16px;
  text-decoration: none;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.size-card:hover {
  background: rgba(126,207,255,0.08);
  border-color: rgba(126,207,255,0.5);
  transform: translateY(-6px);
  box-shadow: 0 20px 40px rgba(126,207,255,0.15);
}

.size-card.has-gift {
  border-color: rgba(255,215,0,0.3);
}

.size-card.has-gift:hover {
  border-color: rgba(255,215,0,0.6);
  box-shadow: 0 20px 40px rgba(255,215,0,0.1);
}

.size-card-badge {
  position: absolute;
  top: 12px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  min-height: 24px;
}

.badge {
  font-size: 0.65rem;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 20px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.badge.starter {
  background: rgba(126,207,255,0.2);
  color: #7ecfff;
  border: 1px solid rgba(126,207,255,0.3);
}

.badge.popular {
  background: linear-gradient(135deg, #7ecfff, #4a9eff);
  color: #0a0f1e;
}

.badge.bestseller {
  background: linear-gradient(135deg, #ffd700, #ffaa00);
  color: #0a0f1e;
}

.badge.premium {
  background: linear-gradient(135deg, #c084fc, #9333ea);
  color: #ffffff;
}

.size-card-visual {
  margin: 30px 0 20px;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  height: 130px;
}

.lamp-icon {
  width: 28px;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.lamp-body {
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #7ecfff 0%, #4a9eff 50%, #1a5fff 100%);
  border-radius: 14px;
  position: relative;
  box-shadow: 0 0 20px rgba(126,207,255,0.6);
}

.lamp-glow {
  position: absolute;
  bottom: -10px;
  width: 40px;
  height: 10px;
  background: radial-gradient(ellipse, rgba(126,207,255,0.4) 0%, transparent 70%);
}

.size-card-info {
  flex: 1;
}

.size-title {
  font-size: 1.3rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 6px;
}

.size-price {
  font-size: 1.5rem;
  font-weight: 800;
  color: #7ecfff;
  margin-bottom: 8px;
}

.size-desc {
  font-size: 0.8rem;
  color: rgba(255,255,255,0.5);
  line-height: 1.4;
  margin-bottom: 10px;
}

.gift-tag {
  display: inline-block;
  background: rgba(255,215,0,0.1);
  border: 1px solid rgba(255,215,0,0.3);
  color: #ffd700;
  font-size: 0.75rem;
  font-weight: 600;
  padding: 5px 12px;
  border-radius: 20px;
  margin-bottom: 12px;
}

.size-card-cta {
  width: 100%;
}

.cta-btn {
  display: block;
  background: linear-gradient(135deg, #7ecfff, #4a9eff);
  color: #0a0f1e;
  padding: 10px 16px;
  border-radius: 8px;
  font-weight: 700;
  font-size: 0.85rem;
  transition: all 0.3s ease;
}

.size-card:hover .cta-btn {
  background: linear-gradient(135deg, #ffffff, #7ecfff);
}

.size-card.has-gift .cta-btn {
  background: linear-gradient(135deg, #ffd700, #ffaa00);
  color: #0a0f1e;
}

.size-selector-footer {
  text-align: center;
  padding: 20px;
  background: rgba(255,215,0,0.05);
  border: 1px solid rgba(255,215,0,0.15);
  border-radius: 12px;
  color: rgba(255,255,255,0.8);
  font-size: 1rem;
}

.size-selector-footer strong {
  color: #ffd700;
}

@media (max-width: 1024px) {
  .size-cards-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 480px) {
  .size-cards-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .size-selector-header h2 {
    font-size: 1.8rem;
  }
}
</style>
