<!-- ═══════════════════════════════════
     STYLES
═══════════════════════════════════════ -->
<style>
.sp-page { background:#060d18; min-height:100vh; }
.sp-container { max-width:1280px; margin:0 auto; padding:0 40px; }

/* Hero */
.sp-hero {
  position:relative;
  background:linear-gradient(135deg,#060d18 0%,#0d1b2a 50%,#091520 100%);
  padding:90px 0 100px;
  overflow:hidden;
}
.sp-bg { position:absolute; inset:0; pointer-events:none; z-index:0; }
.sp-bubble {
  position:absolute; border-radius:50%;
  background:radial-gradient(circle,rgba(0,201,200,0.15),transparent 70%);
  animation:spFloat linear infinite;
}
.sp-bubble--1{width:300px;height:300px;left:5%;top:10%;animation-duration:12s;}
.sp-bubble--2{width:200px;height:200px;left:20%;top:60%;animation-duration:15s;animation-delay:2s;}
.sp-bubble--3{width:150px;height:150px;left:70%;top:20%;animation-duration:10s;animation-delay:1s;}
.sp-bubble--4{width:250px;height:250px;left:80%;top:65%;animation-duration:18s;animation-delay:3s;}
.sp-glow--left {
  position:absolute;left:-200px;top:50%;transform:translateY(-50%);
  width:600px;height:600px;border-radius:50%;
  background:radial-gradient(circle,rgba(0,201,200,0.08),transparent 70%);
}
.sp-glow--right {
  position:absolute;right:-200px;top:30%;
  width:500px;height:500px;border-radius:50%;
  background:radial-gradient(circle,rgba(102,51,255,0.08),transparent 70%);
}
@keyframes spFloat {
  0%,100%{transform:translateY(0) scale(1);opacity:.6}
  50%{transform:translateY(-40px) scale(1.05);opacity:1}
}
.sp-hero-grid {
  position:relative; z-index:1;
  display:grid; grid-template-columns:1fr 1fr;
  gap:80px; align-items:center;
}

/* Visual */
.sp-visual { display:flex; flex-direction:column; gap:20px; }
.sp-frame {
  position:relative; border-radius:28px; overflow:hidden;
  background:linear-gradient(135deg,#0f2030,#1a3050);
  border:1px solid rgba(0,201,200,0.2);
  box-shadow:0 0 0 1px rgba(0,201,200,0.1),0 30px 80px rgba(0,0,0,0.5),inset 0 1px 0 rgba(255,255,255,0.05);
}
.sp-frame-glow {
  position:absolute;inset:0;pointer-events:none;z-index:2;
  background:radial-gradient(ellipse at 50% 120%,rgba(0,201,200,0.12),transparent 60%);
}
.sp-main-img {
  width:100%; display:block;
  animation:spImgFloat 6s ease-in-out infinite;
}
.sp-frame:hover .sp-main-img { transform:scale(1.04); }
@keyframes spImgFloat {
  0%,100%{transform:translateY(0)}
  50%{transform:translateY(-12px)}
}
.sp-img-placeholder {
  width:100%; aspect-ratio:1;
  display:flex; align-items:center; justify-content:center;
  background:rgba(0,201,200,0.03);
}
.sp-tube {
  width:70px; height:280px;
  background:linear-gradient(180deg,rgba(0,201,200,0.6),rgba(102,51,255,0.4));
  border-radius:35px 35px 0 0; position:relative;
  box-shadow:0 0 40px rgba(0,201,200,0.4);
  animation:spTubeGlow 3s ease-in-out infinite;
}
@keyframes spTubeGlow {
  0%,100%{box-shadow:0 0 40px rgba(0,201,200,0.4)}
  50%{box-shadow:0 0 70px rgba(0,201,200,0.7)}
}
.sp-fish {
  position:absolute; font-size:24px;
  left:50%; top:35%; transform:translateX(-50%);
  animation:spFishSwim 4s ease-in-out infinite;
}
.sp-fish--2 { font-size:18px; top:60%; animation-delay:2s; }
@keyframes spFishSwim {
  0%,100%{transform:translateX(-50%) translateY(0)}
  50%{transform:translateX(-50%) translateY(-20px)}
}
.sp-orb { position:absolute; border-radius:50%; pointer-events:none; }
.sp-orb--1 {
  width:120px; height:120px; bottom:-30px; left:-30px;
  background:radial-gradient(circle,rgba(0,201,200,0.2),transparent 70%);
  animation:spPulse 4s ease-in-out infinite;
}
.sp-orb--2 {
  width:80px; height:80px; top:20px; right:-20px;
  background:radial-gradient(circle,rgba(102,51,255,0.2),transparent 70%);
  animation:spPulse 6s ease-in-out infinite reverse;
}
@keyframes spPulse {
  0%,100%{transform:scale(1);opacity:.6}
  50%{transform:scale(1.3);opacity:1}
}
.sp-live-badge {
  position:absolute; top:16px; left:16px; z-index:5;
  background:rgba(13,27,42,0.85); backdrop-filter:blur(8px);
  border:1px solid rgba(0,201,200,0.3); color:#00c9c8;
  font-size:11px; font-weight:700; letter-spacing:1px;
  padding:6px 12px; border-radius:50px;
  display:flex; align-items:center; gap:6px;
}
.sp-live-dot {
  width:7px; height:7px; border-radius:50%;
  background:#00c9c8; animation:spBlink 1.5s ease-in-out infinite;
}
@keyframes spBlink {
  0%,100%{opacity:1} 50%{opacity:.2}
}
.sp-discount-tag {
  position:absolute; top:16px; right:16px; z-index:5;
  background:linear-gradient(135deg,#ff4d6d,#c9184a);
  color:white; border-radius:12px; padding:8px 12px; text-align:center;
  box-shadow:0 4px 16px rgba(255,77,109,0.4);
}
.sp-disc-num { display:block; font-size:20px; font-weight:900; line-height:1; }
.sp-disc-txt { display:block; font-size:10px; font-weight:700; letter-spacing:1px; }

/* Info */
.sp-info { display:flex; flex-direction:column; gap:0; }
.sp-labels { display:flex; gap:10px; margin-bottom:18px; }
.sp-label {
  display:inline-flex; align-items:center; gap:6px;
  padding:5px 14px; border-radius:50px;
  font-size:11px; font-weight:700; letter-spacing:.5px;
}
.sp-label--fire {
  background:rgba(231,76,60,0.12);
  border:1px solid rgba(231,76,60,0.3); color:#e74c3c;
}
.sp-label--stock {
  background:rgba(34,197,94,0.12);
  border:1px solid rgba(34,197,94,0.3); color:#22c55e;
}
.sp-title {
  font-size:clamp(32px,4vw,52px); font-weight:900;
  color:#fff; line-height:1.1; margin-bottom:14px; letter-spacing:-1px;
}
.sp-title-accent {
  display:block;
  background:linear-gradient(135deg,#00c9c8,#0099cc,#6633ff);
  -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
}
.sp-desc {
  font-size:15px; color:rgba(255,255,255,0.6);
  line-height:1.7; margin-bottom:16px;
}
.sp-stars-link { text-decoration:none; display:inline-block; margin-bottom:20px; }
.sp-stars-row {
  display:flex; align-items:center; gap:8px;
  padding:8px 14px; border-radius:50px;
  background:rgba(240,192,64,0.06);
  border:1px solid rgba(240,192,64,0.15);
  transition:all .3s ease; width:fit-content;
}
.sp-stars-link:hover .sp-stars-row {
  background:rgba(240,192,64,0.12);
  border-color:rgba(240,192,64,0.35);
  transform:translateY(-2px);
  box-shadow:0 6px 20px rgba(240,192,64,0.15);
}
.sp-stars-icons { color:#f0c040; font-size:14px; display:flex; gap:2px; }
.sp-stars-num { font-size:15px; font-weight:800; color:#fff; }
.sp-stars-count { font-size:13px; color:rgba(255,255,255,0.5); }
.sp-stars-cta { font-size:12px; font-weight:700; color:#00c9c8; margin-left:4px; }
.sp-divider {
  height:1px;
  background:linear-gradient(90deg,transparent,rgba(0,201,200,0.2),transparent);
  margin:4px 0 20px;
}

/* Sizes */
.sp-sizes-label {
  font-size:13px; font-weight:700; color:rgba(255,255,255,0.7);
  text-transform:uppercase; letter-spacing:1px;
  margin-bottom:12px; display:flex; align-items:center; gap:8px;
}
.sp-sizes-grid {
  display:grid; grid-template-columns:repeat(4,1fr);
  gap:10px; margin-bottom:14px;
}
.sp-size-card {
  position:relative;
  background:rgba(255,255,255,0.04);
  border:1.5px solid rgba(255,255,255,0.08);
  border-radius:16px; padding:14px 10px; text-align:center;
  cursor:pointer; transition:all .25s ease; overflow:hidden;
}
.sp-size-card::before {
  content:''; position:absolute; inset:0;
  background:linear-gradient(135deg,rgba(0,201,200,0.08),transparent);
  opacity:0; transition:opacity .25s ease; border-radius:14px;
}
.sp-size-card:hover,
.sp-size-card--selected {
  border-color:#00c9c8; background:rgba(0,201,200,0.08);
  transform:translateY(-4px); box-shadow:0 8px 24px rgba(0,201,200,0.2);
}
.sp-size-card:hover::before,
.sp-size-card--selected::before { opacity:1; }
.sp-size-card--popular { border-color:rgba(0,201,200,0.4); }
.sp-size-ribbon {
  position:absolute; top:0; right:0;
  background:linear-gradient(135deg,#00c9c8,#0099cc);
  color:white; font-size:9px; font-weight:700;
  padding:3px 8px; border-radius:0 14px 0 10px; letter-spacing:.3px;
}
.sp-size-icon {
  font-size:18px; color:rgba(255,255,255,0.3);
  margin-bottom:6px; transition:color .25s;
}
.sp-size-card:hover .sp-size-icon,
.sp-size-card--selected .sp-size-icon { color:#00c9c8; }
.sp-size-name {
  font-size:12px; font-weight:700;
  color:rgba(255,255,255,0.85); margin-bottom:4px; line-height:1.3;
}
.sp-size-price { font-size:14px; font-weight:800; color:#fff; margin-bottom:6px; }
.sp-size-gift {
  font-size:9px; font-weight:700; color:#f0c040;
  background:rgba(240,192,64,0.1);
  border:1px solid rgba(240,192,64,0.25);
  border-radius:50px; padding:2px 6px;
  display:inline-flex; align-items:center; gap:3px;
}

/* Gift Dynamic */
.sp-gift-dynamic { margin-bottom:12px; min-height:40px; transition:all .3s ease; }
.sp-gift-dynamic-msg {
  display:flex; align-items:center; gap:10px;
  padding:10px 16px; border-radius:12px;
  font-size:13px; font-weight:600;
  animation:spFadeIn .3s ease;
}
.sp-gift-dynamic-msg--good {
  background:rgba(34,197,94,0.1);
  border:1px solid rgba(34,197,94,0.3); color:#22c55e;
}
.sp-gift-dynamic-msg--warn {
  background:rgba(255,165,0,0.1);
  border:1px solid rgba(255,165,0,0.35); color:#ffaa00;
}
@keyframes spFadeIn {
  from{opacity:0;transform:translateY(-6px)}
  to{opacity:1;transform:translateY(0)}
}

/* Gift Banner */
.sp-gift-banner {
  display:flex; align-items:center; gap:14px;
  background:linear-gradient(135deg,rgba(240,192,64,0.08),rgba(240,192,64,0.03));
  border:1px solid rgba(240,192,64,0.25);
  border-radius:16px; padding:16px 20px; margin-bottom:24px;
  position:relative; overflow:hidden; transition:all .4s ease;
}
.sp-gift-banner.sp-gift-banner--hidden { opacity:.35; filter:grayscale(.6); }
.sp-gift-banner::before {
  content:''; position:absolute; top:0; left:0; right:0; height:1px;
  background:linear-gradient(90deg,transparent,rgba(240,192,64,0.5),transparent);
}
.sp-gift-icon {
  width:44px; height:44px; border-radius:12px;
  background:linear-gradient(135deg,rgba(240,192,64,0.2),rgba(240,192,64,0.05));
  border:1px solid rgba(240,192,64,0.3);
  display:flex; align-items:center; justify-content:center;
  font-size:20px; color:#f0c040; flex-shrink:0;
}
.sp-gift-text {
  font-size:13px; color:rgba(255,255,255,0.75); line-height:1.5; flex:1;
}
.sp-gift-text strong { color:#f0c040; display:block; font-size:14px; margin-bottom:2px; }
.sp-gift-value { color:#f0c040; font-weight:700; }
.sp-gift-ribbon {
  font-size:28px; flex-shrink:0;
  animation:spSwing 3s ease-in-out infinite;
}
@keyframes spSwing {
  0%,100%{transform:rotate(-10deg)}
  50%{transform:rotate(10deg)}
}

/* CTA Buttons */
.sp-ctas { display:flex; gap:12px; margin-bottom:24px; }
.sp-btn-main {
  flex:1; display:flex; align-items:center; justify-content:center; gap:10px;
  background:linear-gradient(135deg,#00c9c8,#0099cc);
  color:white; font-size:15px; font-weight:800;
  padding:18px 24px; border-radius:16px; border:none; cursor:pointer;
  transition:all .3s ease; position:relative; overflow:hidden;
  box-shadow:0 8px 32px rgba(0,201,200,0.35);
}
.sp-btn-main::before {
  content:''; position:absolute; top:0; left:-100%;
  width:100%; height:100%;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,0.15),transparent);
  transition:left .5s ease;
}
.sp-btn-main:hover::before { left:100%; }
.sp-btn-main:hover {
  transform:translateY(-3px);
  box-shadow:0 16px 48px rgba(0,201,200,0.5);
  color:white;
}
.sp-btn-icon { font-size:18px; animation:spBolt 2s ease-in-out infinite; }
@keyframes spBolt {
  0%,100%{transform:scale(1)} 50%{transform:scale(1.2)}
}
.sp-btn-arrow { margin-left:auto; opacity:.7; transition:transform .3s; }
.sp-btn-main:hover .sp-btn-arrow { transform:translateX(4px); opacity:1; }
.sp-btn-cart {
  display:flex; align-items:center; gap:8px;
  background:rgba(255,255,255,0.05);
  border:1.5px solid rgba(255,255,255,0.15);
  color:rgba(255,255,255,0.85);
  font-size:14px; font-weight:700;
  padding:18px 22px; border-radius:16px;
  cursor:pointer; transition:all .3s ease; white-space:nowrap;
}
.sp-btn-cart:hover {
  background:rgba(255,255,255,0.1);
  border-color:rgba(255,255,255,0.3);
  color:white; transform:translateY(-3px);
}
.sp-btn-cart:disabled,
.sp-btn-main:disabled { opacity:.6; cursor:not-allowed; transform:none !important; }

/* Trust Row */
.sp-trust-row {
  display:grid; grid-template-columns:repeat(4,1fr); gap:8px;
}
.sp-trust-item {
  display:flex; flex-direction:column; align-items:center; gap:6px;
  padding:12px 8px;
  background:rgba(255,255,255,0.03);
  border:1px solid rgba(255,255,255,0.06);
  border-radius:12px; text-align:center; transition:all .3s;
}
.sp-trust-item:hover {
  background:rgba(0,201,200,0.06);
  border-color:rgba(0,201,200,0.2);
}
.sp-trust-item i { font-size:18px; color:#00c9c8; }
.sp-trust-item span {
  font-size:10px; font-weight:600;
  color:rgba(255,255,255,0.5);
  text-transform:uppercase; letter-spacing:.5px; line-height:1.3;
}

/* Reviews */
.sp-reviews {
  background:linear-gradient(180deg,#060d18,#0a1520,#060d18);
  padding:80px 0 100px;
  border-top:1px solid rgba(0,201,200,0.1);
}
.sp-reviews-header {
  display:grid; grid-template-columns:auto 1fr;
  gap:60px; align-items:center;
  margin-bottom:60px; padding:40px;
  background:rgba(255,255,255,0.02);
  border:1px solid rgba(255,255,255,0.06);
  border-radius:24px;
}
.sp-reviews-score { text-align:center; }
.sp-score-num {
  font-size:80px; font-weight:900; color:#fff;
  line-height:1; letter-spacing:-4px;
}
.sp-score-stars {
  font-size:24px; color:#f0c040;
  display:flex; gap:4px; margin:8px 0; justify-content:center;
}
.sp-score-total { font-size:14px; color:rgba(255,255,255,0.5); font-weight:500; }
.sp-score-bars { display:flex; flex-direction:column; gap:10px; }
.sp-bar-row { display:flex; align-items:center; gap:12px; }
.sp-bar-label {
  font-size:13px; color:rgba(255,255,255,0.5);
  font-weight:600; width:30px; text-align:right;
}
.sp-bar-track {
  flex:1; height:8px;
  background:rgba(255,255,255,0.06);
  border-radius:50px; overflow:hidden;
}
.sp-bar-fill {
  height:100%;
  background:linear-gradient(90deg,#00c9c8,#0099cc);
  border-radius:50px;
}
.sp-bar-pct {
  font-size:12px; color:rgba(255,255,255,0.4);
  width:30px; font-weight:600;
}
.sp-reviews-grid {
  display:grid; grid-template-columns:repeat(3,1fr);
  gap:20px; margin-bottom:48px;
}
.sp-review-card {
  background:rgba(255,255,255,0.03);
  border:1px solid rgba(255,255,255,0.07);
  border-radius:20px; padding:24px;
  transition:all .3s ease;
}
.sp-review-card:hover {
  background:rgba(0,201,200,0.04);
  border-color:rgba(0,201,200,0.2);
  transform:translateY(-4px);
  box-shadow:0 12px 40px rgba(0,0,0,0.3);
}
.sp-rv-header { display:flex; align-items:center; gap:12px; margin-bottom:10px; }
.sp-rv-avatar {
  width:42px; height:42px; border-radius:50%;
  background:linear-gradient(135deg,#00c9c8,#0099cc);
  display:flex; align-items:center; justify-content:center;
  font-size:16px; font-weight:800; color:white; flex-shrink:0;
}
.sp-rv-avatar--b{background:linear-gradient(135deg,#6633ff,#0099cc);}
.sp-rv-avatar--c{background:linear-gradient(135deg,#ff4d6d,#ff8c42);}
.sp-rv-avatar--d{background:linear-gradient(135deg,#22c55e,#0099cc);}
.sp-rv-avatar--e{background:linear-gradient(135deg,#f0c040,#ff8c42);}
.sp-rv-avatar--f{background:linear-gradient(135deg,#00c9c8,#6633ff);}
.sp-rv-name { font-size:14px; font-weight:700; color:#fff; }
.sp-rv-date { font-size:12px; color:rgba(255,255,255,0.35); margin-top:2px; }
.sp-rv-stars { margin-left:auto; color:#f0c040; font-size:13px; letter-spacing:1px; }
.sp-rv-badge {
  display:inline-flex; align-items:center; gap:4px;
  background:rgba(34,197,94,0.1);
  border:1px solid rgba(34,197,94,0.2);
  color:#22c55e; font-size:10px; font-weight:700;
  padding:3px 10px; border-radius:50px;
  margin-bottom:12px; letter-spacing:.3px;
}
.sp-rv-text {
  font-size:14px; color:rgba(255,255,255,0.65);
  line-height:1.7; margin-bottom:14px; font-style:italic;
}
.sp-rv-size { font-size:11px; color:rgba(255,255,255,0.35); font-weight:600; letter-spacing:.3px; }
.sp-reviews-footer { text-align:center; }
.sp-reviews-btn {
  display:inline-flex; align-items:center; gap:12px;
  background:linear-gradient(135deg,#00c9c8,#0099cc);
  color:white; font-size:15px; font-weight:800;
  padding:18px 40px; border-radius:16px;
  text-decoration:none;
  box-shadow:0 8px 32px rgba(0,201,200,0.35);
  transition:all .3s ease; position:relative; overflow:hidden;
}
.sp-reviews-btn::before {
  content:''; position:absolute; top:0; left:-100%;
  width:100%; height:100%;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,0.15),transparent);
  transition:left .5s ease;
}
.sp-reviews-btn:hover::before { left:100%; }
.sp-reviews-btn:hover {
  transform:translateY(-3px);
  box-shadow:0 16px 48px rgba(0,201,200,0.5);
  color:white;
}

/* Shake */
@keyframes spShake {
  0%,100%{transform:translateX(0)}
  20%{transform:translateX(-8px)}
  40%{transform:translateX(8px)}
  60%{transform:translateX(-5px)}
  80%{transform:translateX(5px)}
}

/* Responsive */
@media(max-width:1024px){
  .sp-hero-grid { grid-template-columns:1fr; gap:48px; text-align:center; }
  .sp-visual { max-width:500px; margin:0 auto; width:100%; }
  .sp-hero { padding:60px 0 80px; }
  .sp-stars-row { margin:0 auto; }
  .sp-trust-row { grid-template-columns:repeat(2,1fr); }
  .sp-sizes-grid { grid-template-columns:repeat(2,1fr); }
  .sp-ctas { flex-direction:column; }
  .sp-reviews-grid { grid-template-columns:1fr 1fr; }
  .sp-reviews-header { grid-template-columns:1fr; gap:30px; text-align:center; }
  .sp-score-num { font-size:60px; }
}
@media(max-width:640px){
  .sp-sizes-grid { grid-template-columns:repeat(2,1fr); }
  .sp-trust-row { grid-template-columns:repeat(2,1fr); }
  .sp-reviews-grid { grid-template-columns:1fr; }
  .sp-container { padding:0 20px; }
  .sp-reviews { padding:60px 0 80px; }
}
</style>

<!-- ═══════════════════════════════════
     SCRIPTS
═══════════════════════════════════════ -->
<script>
var spSelectedVariantId = null;

function spSelectSize(card) {
  document.querySelectorAll('.sp-size-card').forEach(function(c) {
    c.classList.remove('sp-size-card--selected');
  });
  card.classList.add('sp-size-card--selected');
  spSelectedVariantId = card.dataset.variantId;

  var hasGift = card.dataset.hasGift === 'true';
  var dynEl   = document.getElementById('sp-gift-dynamic');
  var bannerEl = document.getElementById('sp-gift-banner');

  if (hasGift) {
    dynEl.innerHTML =
      '<div class="sp-gift-dynamic-msg sp-gift-dynamic-msg--good">' +
      '<i class="fas fa-gift"></i>' +
      '&nbsp;🎉 Great choice! You\'ll receive a <strong>&nbsp;FREE Bluetooth Lamp</strong>&nbsp;($60 value)!' +
      '</div>';
    if (bannerEl) bannerEl.classList.remove('sp-gift-banner--hidden');
  } else {
    dynEl.innerHTML =
      '<div class="sp-gift-dynamic-msg sp-gift-dynamic-msg--warn">' +
      '<i class="fas fa-exclamation-circle"></i>' +
      '&nbsp;⚠️ Upgrade to <strong>&nbsp;48" or 60"&nbsp;</strong> to unlock your <strong>FREE Bluetooth Lamp</strong>!' +
      '</div>';
    if (bannerEl) bannerEl.classList.add('sp-gift-banner--hidden');
  }
}

function spBuyNow() {
  if (!spSelectedVariantId) { spShakeGrid(); return; }
  var btn     = document.getElementById('sp-btn-main');
  var btnText = document.getElementById('sp-buy-text');
  var cartBtn = document.getElementById('sp-btn-cart');
  btn.disabled = cartBtn.disabled = true;
  btnText.textContent = 'Processing...';

  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: parseInt(spSelectedVariantId), quantity: 1 })
  })
  .then(function(r){ return r.json(); })
  .then(function(){
    window.location.href = '/checkout';
  })
  .catch(function(){
    btnText.textContent = 'Error — Try Again';
    btn.disabled = cartBtn.disabled = false;
    setTimeout(function(){ btnText.textContent = 'Buy Now — Get Yours Today'; }, 2000);
  });
}

function spAddToCart() {
  if (!spSelectedVariantId) { spShakeGrid(); return; }
  var btn     = document.getElementById('sp-btn-cart');
  var btnText = document.getElementById('sp-cart-text');
  var mainBtn = document.getElementById('sp-btn-main');
  btn.disabled = mainBtn.disabled = true;
  btnText.textContent = 'Adding...';

  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: parseInt(spSelectedVariantId), quantity: 1 })
  })
  .then(function(r){ return r.json(); })
  .then(function(){
    btnText.textContent = 'Added! ✓';
    setTimeout(function(){
      window.location.href = '/cart';
    }, 600);
  })
  .catch(function(){
    btnText.textContent = 'Error — Try Again';
    btn.disabled = mainBtn.disabled = false;
    setTimeout(function(){ btnText.textContent = 'Add to Cart'; }, 2000);
  });
}

function spShakeGrid() {
  var grid = document.querySelector('.sp-sizes-grid');
  if (!grid) return;
  grid.style.animation = 'none';
  grid.offsetHeight;
  grid.style.animation = 'spShake 0.4s ease';
  var dynEl = document.getElementById('sp-gift-dynamic');
  if (dynEl) {
    dynEl.innerHTML =
      '<div class="sp-gift-dynamic-msg sp-gift-dynamic-msg--warn">' +
      '<i class="fas fa-hand-pointer"></i>&nbsp; Please select a size first!' +
      '</div>';
  }
}

document.addEventListener('DOMContentLoaded', function() {
  var starsLink = document.querySelector('.sp-stars-link');
  if (starsLink) {
    starsLink.addEventListener('click', function(e) {
      e.preventDefault();
      var target = document.getElementById('sp-reviews-section');
      if (target) {
        target.scrollIntoView({ behavior:'smooth', block:'start' });
      }
    });
  }
});
</script>

