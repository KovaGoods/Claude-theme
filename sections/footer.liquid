<footer class="site-footer">
  <div class="footer-top">
    <div class="container">
      <div class="footer-grid">

        <div class="footer-col footer-brand">
          <div class="footer-logo">
            <span class="logo-kova">KOVA</span>
            <span class="logo-goods">GOODS</span>
          </div>
          <p class="footer-tagline">Bring the Ocean Home 🌊</p>
          <p class="footer-desc">
            Premium Sensory Bubble Fish Lamps designed to transform your space and calm your mind.
          </p>
          <div class="footer-emails">
            <a href="mailto:support@kovagoods.store">
              <i class="fas fa-envelope"></i> support@kovagoods.store
            </a>
            <a href="mailto:info@kovagoods.store">
              <i class="fas fa-envelope"></i> info@kovagoods.store
            </a>
          </div>
        </div>

        <div class="footer-col">
          <h4 class="footer-heading">Quick Links</h4>
          <ul class="footer-links">
            <li><a href="/">Home</a></li>
            <li><a href="/pages/shop">Shop</a></li>
            <li><a href="/pages/about">About Us</a></li>
            <li><a href="/pages/faq">FAQ</a></li>
            <li><a href="/pages/contact">Contact</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-heading">Policies</h4>
          <ul class="footer-links">
            <li><a href="/policies/shipping-policy">Shipping Policy</a></li>
            <li><a href="/policies/refund-policy">Return Policy</a></li>
            <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
            <li><a href="/policies/terms-of-service">Terms of Service</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-heading">Get 10% Off</h4>
          <p class="footer-newsletter-text">
            Subscribe to our newsletter and get 10% off your first order!
          </p>

          <!-- ✅ الفورم الصح -->
          {% form 'customer' %}
            <input type="hidden" name="contact[tags]" value="newsletter,discount-10">
            <input type="hidden" name="contact[accepts_marketing]" value="true">

            {% if form.posted_successfully? %}
              <!-- ✅ رسالة النجاح -->
              <div class="footer-success">
                <span>🎉</span>
                <div>
                  <strong>You're in!</strong>
                  <p>Check your email for your 10% discount code.</p>
                </div>
              </div>
            {% else %}
              <div class="footer-form">
                <input
                  type="email"
                  name="contact[email]"
                  placeholder="Your email address"
                  class="footer-input"
                  required
                >
                <button type="submit" class="footer-submit">
                  <i class="fas fa-paper-plane"></i>
                </button>
              </div>

              {% if form.errors %}
                <p class="footer-error">⚠️ {{ form.errors.messages['email'] | first }}</p>
              {% endif %}
            {% endif %}

          {% endform %}

          <div class="footer-badges">
            <i class="fab fa-cc-visa"></i>
            <i class="fab fa-cc-mastercard"></i>
            <i class="fab fa-cc-paypal"></i>
            <i class="fab fa-cc-amex"></i>
          </div>
        </div>

      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container">
      <p>© 2024 Kova Goods. All Rights Reserved. | Shipping to USA Only 🇺🇸</p>
    </div>
  </div>
</footer>

<style>
.site-footer { background: var(--color-dark); color: rgba(255,255,255,0.7); }
.footer-top { padding: 80px 0 60px; }
.footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1.5fr; gap: 48px; }
.footer-logo { display: flex; gap: 4px; align-items: baseline; margin-bottom: 8px; }
.footer-logo .logo-kova { font-size: 24px; font-weight: 800; color: var(--color-white); letter-spacing: 3px; }
.footer-logo .logo-goods { font-size: 12px; font-weight: 300; color: var(--color-aqua); letter-spacing: 5px; margin-left: 4px; }
.footer-tagline { color: var(--color-aqua); font-size: 14px; font-weight: 600; margin-bottom: 16px; }
.footer-desc { font-size: 14px; line-height: 1.7; margin-bottom: 24px; color: rgba(255,255,255,0.5); }
.footer-emails { display: flex; flex-direction: column; gap: 8px; }
.footer-emails a { font-size: 13px; color: rgba(255,255,255,0.6); transition: var(--transition); display: flex; align-items: center; gap: 8px; }
.footer-emails a:hover { color: var(--color-aqua); }
.footer-emails i { color: var(--color-aqua); font-size: 12px; }
.footer-heading { font-size: 14px; font-weight: 700; color: var(--color-white); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 24px; }
.footer-links { list-style: none; display: flex; flex-direction: column; gap: 12px; }
.footer-links a { font-size: 14px; color: rgba(255,255,255,0.5); transition: var(--transition); }
.footer-links a:hover { color: var(--color-aqua); padding-left: 6px; }
.footer-newsletter-text { font-size: 13px; color: rgba(255,255,255,0.5); line-height: 1.6; margin-bottom: 16px; }

/* Form */
.footer-form { display: flex; gap: 0; margin-bottom: 16px; }
.footer-input {
  flex: 1; padding: 12px 16px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-right: none;
  border-radius: 8px 0 0 8px;
  color: white; font-size: 13px;
  font-family: var(--font-main); outline: none;
  transition: border-color 0.3s;
}
.footer-input::placeholder { color: rgba(255,255,255,0.3); }
.footer-input:focus { border-color: var(--color-aqua); }
.footer-submit {
  background: var(--color-aqua); border: none;
  padding: 12px 18px;
  border-radius: 0 8px 8px 0;
  color: white; cursor: pointer;
  font-size: 16px; transition: var(--transition);
}
.footer-submit:hover { background: #0099CC; }

/* Success Message */
.footer-success {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  background: rgba(0, 255, 136, 0.08);
  border: 1px solid rgba(0, 255, 136, 0.25);
  border-radius: 10px;
  padding: 14px 16px;
  margin-bottom: 16px;
  font-size: 13px;
}
.footer-success span { font-size: 22px; }
.footer-success strong { color: #00ff88; display: block; margin-bottom: 2px; }
.footer-success p { color: rgba(255,255,255,0.6); margin: 0; }

/* Error Message */
.footer-error {
  font-size: 12px;
  color: #ff8080;
  margin-top: 8px;
  margin-bottom: 12px;
}

/* Payment Badges */
.footer-badges { display: flex; gap: 12px; font-size: 28px; color: rgba(255,255,255,0.3); margin-top: 16px; }

/* Footer Bottom */
.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.05);
  padding: 20px 0;
  text-align: center;
  font-size: 13px;
  color: rgba(255,255,255,0.3);
}

/* Responsive */
@media (max-width: 1024px) { .footer-grid { grid-template-columns: 1fr 1fr; gap: 40px; } }
@media (max-width: 480px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
